{
  "realm": "tvtracker",
  "displayName": "TV Tracker",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "tvtracker-web",
      "name": "TV Tracker web app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "tvtracker-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:7120/*",
        "http://localhost:5120/*"
      ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7120/*##http://localhost:5120/*"
      },
      "protocolMappers": [
        {
          "name": "tvtracker-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tvtracker-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tvtracker-mobile",
      "name": "TV Tracker mobile app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [ "tvtracker://callback" ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "tvtracker://callback"
      },
      "protocolMappers": [
        {
          "name": "tvtracker-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tvtracker-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tvtracker-identity-admin",
      "name": "Identity.API (deletes Keycloak users)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "tvtracker-identity-admin-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ]
    },
    {
      "username": "service-account-tvtracker-identity-admin",
      "enabled": true,
      "serviceAccountClientId": "tvtracker-identity-admin",
      "clientRoles": {
        "realm-management": [ "manage-users", "view-users" ]
      }
    }
  ]
}
