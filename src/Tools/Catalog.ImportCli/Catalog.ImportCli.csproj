<Project Sdk="Microsoft.NET.Sdk">

  <!--
    tvtracker-import: bulk imports shows into the catalog through the sync worker's internal import endpoints,
    so provider calls, rate limiting, writes and catalog events stay in the worker. Run it while the AppHost is running.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tvtracker-import</AssemblyName>
    <RootNamespace>Catalog.ImportCli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
