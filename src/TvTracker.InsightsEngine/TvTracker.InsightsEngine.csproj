  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Analytics.API" />
    <InternalsVisibleTo Include="Analytics.Worker" />
    <InternalsVisibleTo Include="Analytics.UnitTests" />
  </ItemGroup>

</Project>
