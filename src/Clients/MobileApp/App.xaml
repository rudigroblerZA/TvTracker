<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TvTracker.Mobile"
             x:Class="TvTracker.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The page behind the web view, which shows behind the system bars: the web UI's own background, light and dark. -->
            <Color x:Key="PageBackgroundColor">#FAFAF9</Color>
            <Color x:Key="PageBackgroundColorDark">#0C0A09</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
