<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    MAUI Blazor Hybrid app for iOS and Android (plus macOS and Windows for desktop testing).
    Hosts the shared TvTracker.UI components and talks to the services only through the Mobile BFF.
    Signs in with Keycloak in the system browser (OIDC + PKCE), keeps tokens in secure storage,
    caches data and queues changes in SQLite for offline use, and handles tvtracker:// deep links.
    Not part of the AppHost: run it from Visual Studio / VS Code / Rider while the AppHost is running.
  -->

  <PropertyGroup>
    <!-- Directory.Build.props sets a single TargetFramework; clear it so this project can multi-target. -->
    <TargetFramework></TargetFramework>
    <!-- iOS and Mac Catalyst build only on a Mac (their workload doesn't exist for Linux), so a Linux build, such as CI,
         targets Android alone. -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>TvTracker.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- MAUI packages follow the MAUI workload version, so this project doesn't use central package versions. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <ApplicationTitle>TV Tracker</ApplicationTitle>
    <ApplicationId>com.tvtracker.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Run as an unpackaged app on Windows -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1C1917" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1C1917" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="IdentityModel.OidcClient" Version="6.0.0" />
    <!-- Feature flags: OpenFeature over OFREP, through the BFF's /features route (the services use flagd's own provider). -->
    <PackageReference Include="OpenFeature.Hosting" Version="2.14.1" />
    <PackageReference Include="OpenFeature.Providers.Ofrep" Version="0.1.7" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TvTracker.UI\TvTracker.UI.csproj" />
  </ItemGroup>

</Project>
