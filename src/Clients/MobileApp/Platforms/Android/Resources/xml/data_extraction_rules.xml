<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing of the app's goes into a cloud backup or a device-to-device transfer (see the
     manifest's note on allowBackup, which older versions read). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
