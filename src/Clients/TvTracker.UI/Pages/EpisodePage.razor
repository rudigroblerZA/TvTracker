@page "/episodes/{Id:guid}"
@inject CatalogClient Catalog
@inject TrackingClient Tracking
@inject RatingsClient Ratings
@inject UserSession Session
@inject SpoilerShield Shield
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(episode is null ? "Episode" : hideTitle ? Format.EpisodeCode(episode.SeasonNumber, episode.EpisodeNumber) : episode.Title) · @Brand.AppName</PageTitle>

<ErrorNotice Message="@error" OnRetry="LoadAsync" />

@if (episode is null)
{
    if (error is null)
    {
        <p class="muted">@(notFound ? "This episode isn't in the catalog." : "Loading…")</p>
    }
}
else
{
    <p><a href="shows/@episode.ShowId">← @(showTitle ?? "Back to show")</a></p>
    <h1>@Format.EpisodeCode(episode.SeasonNumber, episode.EpisodeNumber)<Spoiler Hidden="!watched">@(" · " + episode.Title)</Spoiler></h1>
    <p class="muted">
        <LocalTime Utc="episode.AirsAtUtc" Format="dddd d MMMM yyyy, HH:mm" />
        @if (episode.RuntimeMinutes is { } runtime)
        {
            <text> · @runtime min</text>
        }
        @if (Format.Label(episode.Label) is { } label)
        {
            <span class="tag">@label</span>
        }
    </p>
    @if (!string.IsNullOrEmpty(episode.Overview))
    {
        <Spoiler Hidden="!watched" Placeholder="Summary hidden: you haven't watched this yet"><p>@episode.Overview</p></Spoiler>
    }

    <div class="rating-line">
        @if (summary is { Count: > 0 })
        {
            <span>★ @summary.Average.ToString("0.0") <span class="muted">(@summary.Count)</span></span>
        }
    </div>

    <Feature Flag="@FeatureFlags.MemorableLines"><EpisodeLinesSection EpisodeId="episode.Id" Watched="watched" /></Feature>

    <AuthorizeView>
        <Authorized>
            <div class="actions">
                <label class="inline checkbox">
                    <input type="checkbox" checked="@watched" @onchange="ToggleWatchedAsync" disabled="@(!aired && !watched)" />
                    @(watched ? "Watched" : aired ? "Mark as watched" : "Not aired yet")
                </label>
                <span class="muted">Your rating</span>
                <StarRating Value="myRating" ValueChanged="RateAsync" />
            </div>

            <Feature Flag="@FeatureFlags.Corrections">
                <SuggestCorrection ShowId="episode.ShowId" EpisodeId="episode.Id"
                                   Context="@($"{showTitle} · {Format.EpisodeCode(episode.SeasonNumber, episode.EpisodeNumber)}")"
                                   Current="@CorrectionValues" />
            </Feature>

            <section>
                <h2>Reactions</h2>
                <div class="reactions">
                    @foreach (var emoji in Emoji)
                    {
                        var count = reactions?.Counts.FirstOrDefault(c => c.Emoji == emoji)?.Count ?? 0;
                        <button class="reaction @(reactions?.Mine == emoji ? "mine" : "")" @onclick="() => ReactAsync(emoji)">
                            @emoji @if (count > 0) { <span>@count</span> }
                        </button>
                    }
                </div>
            </section>

            <Feature Flag="@FeatureFlags.CharacterVoting">
                @* Keyed by episode: on another one the section starts afresh, with nothing of the last one's to show or vote from. *@
                <CharacterVoteSection @key="episode.Id" EpisodeId="episode.Id" ShowId="episode.ShowId" Cast="cast" Watched="watched" />
            </Feature>

            <section>
                <h2>Comments</h2>
                @if (comments is null)
                {
                    <p class="muted">Loading…</p>
                }
                else if (comments.HiddenUntilWatched)
                {
                    <div class="panel">
                        <p>@comments.TotalCount comment(s) hidden to avoid spoilers until you've watched this episode.</p>
                        <button class="btn btn-quiet" @onclick="() => LoadCommentsAsync(reveal: true)">Show anyway</button>
                    </div>
                }
                else
                {
                    <form class="comment-form" @onsubmit="PostCommentAsync">
                        <textarea @bind="newComment" @bind:event="oninput" maxlength="2000" placeholder="What did you think? Words, emoji or a GIF." aria-label="Comment"></textarea>
                        @if (pickedGif is { } picked)
                        {
                            <div class="comment-gif-picked">
                                <img class="comment-gif" src="@picked.Url" alt="@GifAlt(picked)" />
                                <button class="link small" type="button" @onclick="() => pickedGif = null">Remove GIF</button>
                            </div>
                        }
                        <div class="comment-tools">
                            <div class="comment-emoji" role="group" aria-label="Add an emoji">
                                @foreach (var emoji in CommentEmoji)
                                {
                                    <button type="button" title="@($"Add {emoji}")" @onclick="() => newComment += emoji">@emoji</button>
                                }
                            </div>
                            @if (comments.Gifs is not null)
                            {
                                <button class="btn btn-quiet small" type="button" aria-expanded="@gifPickerOpen" @onclick="ToggleGifPickerAsync">GIF</button>
                            }
                        </div>
                        @if (gifPickerOpen)
                        {
                            <div class="gif-picker panel">
                                <div class="gif-picker-head">
                                    <input type="search" value="@gifQuery" @oninput="e => gifQuery = e.Value?.ToString()" @onkeydown="OnGifKeyAsync" @onkeydown:preventDefault="gifEnter"
                                           placeholder="Search GIPHY" maxlength="50" aria-label="Search for a GIF" />
                                    <button class="btn btn-quiet small" type="button" @onclick="SearchGifsAsync">Search</button>
                                </div>
                                @if (gifError is not null)
                                {
                                    <p class="muted small">@gifError</p>
                                }
                                else if (gifResults is null)
                                {
                                    <p class="muted small">Loading…</p>
                                }
                                else if (gifResults.Count == 0)
                                {
                                    <p class="muted small">No GIFs for that. Try other words.</p>
                                }
                                else
                                {
                                    <div class="gif-grid">
                                        @foreach (var gif in gifResults)
                                        {
                                            <button @key="gif.Id" type="button" title="@GifAlt(gif)" @onclick="() => PickGif(gif)">
                                                <img src="@gif.Url" alt="@GifAlt(gif)" loading="lazy" />
                                            </button>
                                        }
                                    </div>
                                }
                                <p class="gif-credit small muted">Powered by <a href="https://giphy.com" target="_blank" rel="noopener noreferrer">GIPHY</a></p>
                            </div>
                        }
                        <label class="inline checkbox"><input type="checkbox" @bind="newCommentIsSpoiler" /> Contains spoilers</label>
                        <button class="btn" type="submit" disabled="@(string.IsNullOrWhiteSpace(newComment) && pickedGif is null)">Post</button>
                    </form>

                    @if (comments.Comments.Any(c => c.IsSpoiler && c.Text is null))
                    {
                        <button class="btn btn-quiet small" @onclick="() => LoadCommentsAsync(reveal: true, includeSpoilers: true)">Show spoilers</button>
                    }

                    <ul class="comments">
                        @foreach (var comment in comments.Comments)
                        {
                            <li>
                                <div class="muted small">@comment.DisplayName · @Format.Relative(comment.CreatedAtUtc)@if (comment.EditedAtUtc is { } edited) { <span title="@($"Edited {Format.Relative(edited)}")"> · edited</span> }</div>
                                @if (editing == comment.Id)
                                {
                                    <form class="comment-form comment-edit" @onsubmit="SaveEditAsync">
                                        <textarea @bind="editText" @bind:event="oninput" maxlength="2000" aria-label="Edit your comment"></textarea>
                                        <label class="inline checkbox"><input type="checkbox" @bind="editIsSpoiler" /> Contains spoilers</label>
                                        <div class="actions">
                                            @* Never disabled for empty words: a comment may be a GIF alone, which isn't sent while GIFs are off, so the service decides. *@
                                            <button class="btn" type="submit">Save</button>
                                            <button class="btn btn-quiet" type="button" @onclick="() => editing = null">Cancel</button>
                                        </div>
                                    </form>
                                }
                                else if (comment.Text is null)
                                {
                                    <em class="muted">Spoiler hidden</em>
                                }
                                else
                                {
                                    @if (comment.IsSpoiler || !string.IsNullOrEmpty(comment.Text))
                                    {
                                        <p class="comment-text">@if (comment.IsSpoiler) { <span class="tag">Spoiler</span> }@(" " + comment.Text)</p>
                                    }
                                    @if (comment.GifId is { } gifId && gifs.TryGetValue(gifId, out var gif))
                                    {
                                        <img class="comment-gif" src="@gif.Url" alt="@GifAlt(gif)" loading="lazy" />
                                    }
                                }
                                <div class="insight-meta small">
                                    @if (comment.HiddenReason is { } hidden)
                                    {
                                        <span class="tag">@CommunityInsightsSection.HiddenLabel(hidden)</span>
                                    }
                                    @if (comment.IsMine)
                                    {
                                        @if (comment.HiddenReason != "moderator" && editing != comment.Id)
                                        {
                                            <button class="link small" @onclick="() => StartEdit(comment)">Edit</button>
                                        }
                                        <button class="link small" @onclick="() => DeleteCommentAsync(comment.Id)">Delete</button>
                                    }
                                    else
                                    {
                                        <FlagButton Kind="comment" Id="comment.Id" Flagged="comment.FlaggedByMe" />
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <Feature Flag="@FeatureFlags.CommunityInsights">
                <CommunityInsightsSection ShowId="episode.ShowId" EpisodeId="episode.Id" />
            </Feature>
        </Authorized>
        <NotAuthorized>
            <SignInPrompt Message="Sign in to mark this episode watched, rate it and join the discussion." />
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    private static readonly string[] Emoji = ["😂", "😮", "😢", "😡", "😍", "🔥", "👏", "🤯"];

    [Parameter] public Guid Id { get; set; }

    private Episode? episode;
    private string? showTitle;
    private IReadOnlyList<CastMember> cast = [];
    private bool notFound;
    private bool watched;

    /// <summary>
    /// The spoiler shield is on and the user hasn't watched this: the tab title shows only the episode code.
    /// </summary>
    private bool hideTitle => shieldOn && !watched;
    private bool shieldOn;
    private bool aired;
    private RatingSummary? summary;
    private int? myRating;
    private Reactions? reactions;
    private CommentsPage? comments;

    /// <summary>
    /// The reader's own comment being edited, with its draft: kept apart from the list, which refreshes underneath.
    /// </summary>
    private Guid? editing;
    private string? editText;
    private bool editIsSpoiler;

    /// <summary>
    /// What the page shows, for "Suggest a correction" (the air date as the profile's calendar would show it is
    /// close enough; the moderator sees both values).
    /// </summary>
    private Dictionary<string, string?> CorrectionValues => episode is null ? [] : new()
    {
        ["episode-title"] = episode.Title,
        ["episode-summary"] = episode.Overview,
        ["episode-airdate"] = episode.AirsAtUtc?.UtcDateTime.ToString("yyyy-MM-dd"),
        ["episode-runtime"] = episode.RuntimeMinutes?.ToString()
    };
    private string? newComment;
    private bool newCommentIsSpoiler;

    private static readonly string[] CommentEmoji = ["😂", "😮", "😢", "😡", "😍", "🔥", "👏", "🤯", "❤️", "👍", "💀", "🍿"];

    /// <summary>
    /// How often the open page asks for new comments.
    /// </summary>
    private static readonly TimeSpan Refresh = TimeSpan.FromSeconds(20);

    // What the reader last chose to see, so a refresh shows the same.
    private bool revealed;
    private bool spoilersShown;
    private CancellationTokenSource? refreshing;

    // GIFs: the browser's GIPHY module, the pictures of the GIFs in view (by id), and the picker's state.
    private IJSObjectReference? giphy;
    private readonly Dictionary<string, GifPicture> gifs = [];
    private readonly HashSet<string> gifsAsked = [];
    private bool gifPickerOpen;
    private bool gifEnter;
    private string? gifQuery;
    private string? gifError;
    private List<GifPicture>? gifResults;
    private GifPicture? pickedGif;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        shieldOn = await Shield.IsOnAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            await Session.EnsureLoadedAsync();
            episode = await Catalog.GetEpisodeAsync(Id);
            notFound = episode is null;
            if (episode is null)
            {
                return;
            }

            aired = episode.AirsAtUtc <= DateTimeOffset.UtcNow;
            var show = await Catalog.GetShowAsync(episode.ShowId, Session.Region);
            showTitle = show?.Title;
            summary = await Ratings.GetEpisodeSummaryAsync(Id);

            if (Session.IsSignedIn)
            {
                var progress = await Tracking.GetProgressAsync(episode.ShowId);
                watched = progress?.WatchedEpisodeIds.Contains(Id) == true;
                // Only now, with watched known: the favourite-character section asks for its votes once it has a cast.
                cast = show?.Cast ?? [];
                myRating = (await Ratings.GetMyEpisodeRatingAsync(Id))?.Stars;
                reactions = await Ratings.GetReactionsAsync(Id);
                await LoadCommentsAsync();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private async Task LoadCommentsAsync(bool reveal = false, bool includeSpoilers = false)
    {
        (revealed, spoilersShown) = (revealed || reveal, spoilersShown || includeSpoilers);
        comments = await Ratings.GetCommentsAsync(Id, revealed || watched, spoilersShown);
        await ShowGifsAsync();
        KeepFresh();
    }

    /// <summary>
    /// While the page is open, asks for the comments again every <see cref="Refresh"/>, so other people's appear
    /// without a reload. A failed round is skipped: the next one tries again.
    /// </summary>
    private void KeepFresh()
    {
        if (refreshing is not null)
        {
            return;
        }
        refreshing = new CancellationTokenSource();
        var stop = refreshing.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(Refresh);
                while (await timer.WaitForNextTickAsync(stop))
                {
                    try
                    {
                        var latest = await Ratings.GetCommentsAsync(Id, revealed || watched, spoilersShown, stop);
                        if (latest is not null)
                        {
                            comments = latest;
                            await ShowGifsAsync();
                            StateHasChanged();
                        }
                    }
                    catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
                    {
                    }
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private async Task<IJSObjectReference> GiphyAsync() =>
        giphy ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/TvTracker.UI/gifs.js");

    /// <summary>
    /// Has the browser ask GIPHY for the GIFs in the comments it hasn't asked about yet. One that GIPHY no longer has,
    /// or a GIPHY that isn't answering, leaves the comment without its picture.
    /// </summary>
    private async Task ShowGifsAsync()
    {
        if (comments?.Gifs is not { } settings)
        {
            return;
        }
        var wanted = comments.Comments.Select(c => c.GifId).OfType<string>().Where(gifsAsked.Add).ToArray();
        if (wanted.Length == 0)
        {
            return;
        }
        try
        {
            foreach (var gif in await (await GiphyAsync()).InvokeAsync<List<GifPicture>>("resolve", settings.ApiKey, wanted))
            {
                gifs[gif.Id] = gif;
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        {
            // Not rendered in a browser yet, or GIPHY didn't answer: ask again next time.
            gifsAsked.ExceptWith(wanted);
        }
    }

    private async Task ToggleGifPickerAsync()
    {
        gifPickerOpen = !gifPickerOpen;
        if (gifPickerOpen && gifResults is null)
        {
            await SearchGifsAsync();
        }
    }

    private async Task OnGifKeyAsync(KeyboardEventArgs e)
    {
        // Enter searches; it mustn't post the comment the picker sits in.
        gifEnter = e.Key == "Enter";
        if (gifEnter)
        {
            await SearchGifsAsync();
        }
    }

    private async Task SearchGifsAsync()
    {
        if (comments?.Gifs is not { } settings)
        {
            return;
        }
        (gifError, gifResults) = (null, null);
        try
        {
            gifResults = await (await GiphyAsync()).InvokeAsync<List<GifPicture>>("search", settings.ApiKey, settings.Rating, gifQuery?.Trim() ?? "");
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        {
            gifError = "GIPHY isn't answering right now. Try again in a moment.";
        }
    }

    private void PickGif(GifPicture gif)
    {
        (pickedGif, gifPickerOpen) = (gif, false);
        gifs[gif.Id] = gif;
        gifsAsked.Add(gif.Id);
    }

    private static string GifAlt(GifPicture gif) => string.IsNullOrWhiteSpace(gif.Title) ? "GIF" : gif.Title;

    public async ValueTask DisposeAsync()
    {
        refreshing?.Cancel();
        refreshing?.Dispose();
        if (giphy is not null)
        {
            try
            {
                await giphy.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private Task ToggleWatchedAsync(ChangeEventArgs e) => RunAsync(async () =>
    {
        watched = e.Value is true;
        if (watched)
        {
            await Tracking.MarkWatchedAsync(new MarkWatched([Id], null, null, null, null));
        }
        else
        {
            await Tracking.UnmarkWatchedAsync(Id);
        }
        await LoadCommentsAsync();
    });

    private Task RateAsync(int stars) => RunAsync(async () =>
    {
        myRating = stars;
        await Ratings.RateEpisodeAsync(Id, episode!.ShowId, stars);
        summary = await Ratings.GetEpisodeSummaryAsync(Id);
    });

    private Task ReactAsync(string emoji) => RunAsync(async () =>
    {
        if (reactions?.Mine == emoji)
        {
            await Ratings.RemoveReactionAsync(Id);
        }
        else
        {
            await Ratings.ReactAsync(Id, emoji);
        }
        reactions = await Ratings.GetReactionsAsync(Id);
    });

    private Task PostCommentAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(newComment) && pickedGif is null)
        {
            return;
        }
        await Ratings.PostCommentAsync(Id, episode!.ShowId, newComment, newCommentIsSpoiler, pickedGif?.Id);
        newComment = null;
        newCommentIsSpoiler = false;
        (pickedGif, gifPickerOpen) = (null, false);
        await LoadCommentsAsync(reveal: true);
    });

    private void StartEdit(Comment comment) => (editing, editText, editIsSpoiler) = (comment.Id, comment.Text, comment.IsSpoiler);

    private Task SaveEditAsync() => RunAsync(async () =>
    {
        if (editing is not { } id)
        {
            return;
        }
        await Ratings.EditCommentAsync(id, editText, editIsSpoiler);
        editing = null;
        await LoadCommentsAsync(reveal: true);
    });

    private Task DeleteCommentAsync(Guid commentId) => RunAsync(async () =>
    {
        await Ratings.DeleteCommentAsync(commentId);
        await LoadCommentsAsync(reveal: true);
    });

    private async Task RunAsync(Func<Task> action)
    {
        error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
