@page "/up-next"
@inject TrackingClient Tracking
@inject AnalyticsClient Analytics

<PageTitle>Up Next · @Brand.AppName</PageTitle>

<h1>Up Next</h1>

<AuthorizeView>
    <Authorized>
        <div class="tool-links">
            <Feature Flag="@FeatureFlags.BacklogTriage" ShowLocked>
                <ToolLink Href="backlog" Title="Your backlog">What to start next from the shows you follow, and what to let go.</ToolLink>
            </Feature>
            <Feature Flag="@FeatureFlags.SpoilerWatch" ShowLocked>
                <ToolLink Href="spoilers" Title="Spoiler watch">Which of your shows have spoilers about right now, and when it's safe again.</ToolLink>
            </Feature>
            <Feature Flag="@FeatureFlags.WaitingRoom" ShowLocked>
                <ToolLink Href="waiting" Title="Waiting room">Shows you're caught up on, and when each is back.</ToolLink>
            </Feature>
            <Feature Flag="@FeatureFlags.TonightPlan" ShowLocked>
                <ToolLink Href="tonight" Title="Plan tonight">Tell it how long you've got and your mood, and it picks the episodes.</ToolLink>
            </Feature>
            <Feature Flag="@FeatureFlags.TimeOff" ShowLocked>
                <ToolLink Href="time-off" Title="Fits your time off">Finished shows you could watch whole in the days you've got.</ToolLink>
            </Feature>
        </div>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        <Feature Flag="@FeatureFlags.CrossoverAlerts"><CrossoversAhead /></Feature>

        @if (catchUps is { Count: > 0 })
        {
            <Feature Flag="@FeatureFlags.CatchUp">
                <section class="before-premiere">
                    <h2>Before the premiere</h2>
                    <ul class="up-next">
                        @foreach (var c in catchUps)
                        {
                            <li @key="c.ShowId">
                                <a href="shows/@c.ShowId"><Poster Title="@c.Title" Url="@c.PosterUrl" Size="small" /></a>
                                <div class="up-next-body">
                                    <a class="strong" href="shows/@c.ShowId">@c.Title</a>
                                    <div class="muted small">
                                        <span>Season @c.Premiere.SeasonNumber @Format.Relative(c.Premiere.PremieresAtUtc) · @CatchUpSection.Episodes(c.Full.Episodes) (@Format.Hours(c.Full.Minutes)) to go</span>
                                    </div>
                                    <a class="small" href="shows/@c.ShowId#catch-up">
                                        <span class="tag tone-@CatchUpSection.Tone(c.Full.Verdict)">@(c.Full.Verdict is { } v ? char.ToUpperInvariant(v[0]) + v[1..] : "Plan")</span><span>@(" " + CatchUpSection.PerWeek(c.Full))</span>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </Feature>
        }

        @if (refreshers is { Count: > 0 })
        {
            <Feature Flag="@FeatureFlags.Refresher">
                <section class="back-after-break">
                    <h2>Back after a break</h2>
                    <ul class="up-next">
                        @foreach (var r in refreshers)
                        {
                            <li @key="r.ShowId">
                                <a href="shows/@r.ShowId"><Poster Title="@r.Title" Url="@r.PosterUrl" Size="small" /></a>
                                <div class="up-next-body">
                                    <a class="strong" href="shows/@r.ShowId">@r.Title</a>
                                    <div class="muted small">
                                        <span>Last watched @RefresherSection.Ago(r.DaysSince)</span>
                                        @if (r.Returns is { NewSeason: true } returns)
                                        {
                                            <span> · season @returns.SeasonNumber starts @Format.Relative(returns.PremieresAtUtc)</span>
                                        }
                                        else if (r.Ahead.Episodes > 0)
                                        {
                                            <span> · @(r.Ahead.Episodes == 1 ? "1 episode" : $"{r.Ahead.Episodes} episodes") to go</span>
                                        }
                                    </div>
                                    <a class="small" href="shows/@r.ShowId#previously-on">Previously on…: a @Format.Duration(r.PlanMinutes) refresher</a>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </Feature>
        }

        @if (items is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (items.Count == 0)
        {
            <p class="muted">You're all caught up. <a href="search">Find something new</a>.</p>
        }
        else
        {
            <ul class="up-next">
                @foreach (var item in items)
                {
                    <li>
                        <a href="shows/@item.ShowId"><Poster Title="@item.ShowTitle" Url="@item.PosterUrl" Size="small" /></a>
                        <div class="up-next-body">
                            <a class="strong" href="shows/@item.ShowId">@item.ShowTitle</a>
                            <div>
                                <a href="episodes/@item.Episode.EpisodeId">@Format.EpisodeCode(item.Episode.SeasonNumber, item.Episode.EpisodeNumber)</a><Spoiler Hidden="true">@(" · " + item.Episode.Title)</Spoiler>
                            </div>
                            <div class="muted small">
                                @if (item.HasAired)
                                {
                                    @(item.RemainingAired == 1 ? "1 episode to watch" : $"{item.RemainingAired} episodes to watch")
                                }
                                else
                                {
                                    <text>Airs <LocalTime Utc="item.Episode.AirsAtUtc" /></text>
                                }
                            </div>
                            <progress max="@Math.Max(1, item.AiredCount)" value="@item.WatchedCount"></progress>
                        </div>
                        @if (item.HasAired)
                        {
                            <button class="btn" @onclick="() => MarkWatchedAsync(item)" aria-label="Mark @item.ShowTitle @Format.EpisodeCode(item.Episode.SeasonNumber, item.Episode.EpisodeNumber) watched">✓ Watched</button>
                        }
                    </li>
                }
            </ul>
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to see the next episode of every show you're watching." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<UpNextItem>? items;
    private List<Refresher>? refreshers;
    private List<CatchUpPlan>? catchUps;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Optional, like the refreshers.</summary>
    private async Task<List<CatchUpPlan>?> LoadCatchUpsAsync()
    {
        try
        {
            return await Analytics.GetCatchUpsAsync();
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    /// <summary>Optional: Up Next works without it (flag off, or Analytics unavailable).</summary>
    private async Task<List<Refresher>?> LoadRefreshersAsync()
    {
        try
        {
            return await Analytics.GetRefreshersAsync();
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            items = await Tracking.GetUpNextAsync() ?? [];
            refreshers = await LoadRefreshersAsync();
            catchUps = await LoadCatchUpsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private async Task MarkWatchedAsync(UpNextItem item)
    {
        try
        {
            await Tracking.MarkWatchedAsync(new MarkWatched([item.Episode.EpisodeId], null, null, null, null));
            await LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
