@page "/up-next"
@inject TrackingClient Tracking
@inject AnalyticsClient Analytics
@inject FeatureFlagStore Flags

<PageTitle>Up Next · @Brand.AppName</PageTitle>

<h1>Up Next</h1>

<AuthorizeView>
    <Authorized>
        @* Three pinned, as on Discover and Insights: the rest of the tools are at the foot of the page. *@
        <div class="feature-cards">
            <Feature Flag="@FeatureFlags.TonightPlan" ShowLocked>
                <FeatureCard Href="tonight" Title="Plan tonight" Tone="mix-3">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <path d="M84 8a32 32 0 1 0 28 46A26 26 0 0 1 84 8z" fill="currentColor" opacity="0.3" />
                            <path d="M84 8a32 32 0 1 0 28 46A26 26 0 0 1 84 8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <path d="M70 30v20l16-10z" fill="currentColor" />
                            <path d="M24 14v10M19 19h10M40 52v8M36 56h8M12 44v6M9 47h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
                        </svg>
                    </Art>
                    <ChildContent>Tell it how long you've got and your mood, and it picks the episodes.</ChildContent>
                </FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.WhileYouWait" ShowLocked>
                <FeatureCard Href="while-you-wait" Title="While you wait" Tone="mix-1">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <path d="M62 8h44M62 72h44" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                            <path d="M68 8c0 18 16 22 16 32s-16 14-16 32h32c0-18-16-22-16-32s16-14 16-32z" fill="currentColor" opacity="0.2" />
                            <path d="M68 8c0 18 16 22 16 32s-16 14-16 32h32c0-18-16-22-16-32s16-14 16-32z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <path d="M74 20h20c-3 8-10 11-10 20c0-9-7-12-10-20zM72 72c2-10 8-12 12-16c4 4 10 6 12 16z" fill="currentColor" />
                            <path d="M14 30h30M22 44h22M30 58h14" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.35" />
                        </svg>
                    </Art>
                    <ChildContent>A finished show you can watch whole before each of yours is back.</ChildContent>
                </FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.BacklogTriage" ShowLocked>
                <FeatureCard Href="backlog" Title="Your backlog" Tone="mix-0">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            @* The cards behind are cut away where the one in front covers them (the card is a gradient, so there is no
                               one colour to paint over them with). *@
                            <mask id="backlog-behind">
                                <rect width="120" height="80" fill="#fff" />
                                <rect x="64" y="14" width="44" height="58" rx="6" fill="#000" />
                            </mask>
                            <g mask="url(#backlog-behind)">
                                <rect x="50" y="6" width="44" height="58" rx="6" fill="currentColor" opacity="0.18" transform="rotate(-10 72 35)" />
                                <rect x="58" y="10" width="44" height="58" rx="6" fill="currentColor" opacity="0.35" transform="rotate(4 80 39)" />
                            </g>
                            <rect x="64" y="14" width="44" height="58" rx="6" fill="currentColor" opacity="0.25" />
                            <rect x="64" y="14" width="44" height="58" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M76 44l8 8 14-18" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M10 26h24M10 40h30M10 54h18" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.35" />
                        </svg>
                    </Art>
                    <ChildContent>What to start next from the shows you follow, and what to let go.</ChildContent>
                </FeatureCard>
            </Feature>
        </div>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        <Feature Flag="@FeatureFlags.CrossoverAlerts"><CrossoversAhead /></Feature>

        @if (catchUps is { Count: > 0 })
        {
            <Feature Flag="@FeatureFlags.CatchUp">
                <section class="before-premiere">
                    <h2>Before the premiere</h2>
                    <ul class="up-next">
                        @foreach (var c in catchUps)
                        {
                            <li @key="c.ShowId">
                                <a href="shows/@c.ShowId"><Poster Title="@c.Title" Url="@c.PosterUrl" Size="small" /></a>
                                <div class="up-next-body">
                                    <a class="strong" href="shows/@c.ShowId">@c.Title</a>
                                    <div class="muted small">
                                        <span>Season @c.Premiere.SeasonNumber @Format.Relative(c.Premiere.PremieresAtUtc) · @CatchUpSection.Episodes(c.Full.Episodes) (@Format.Hours(c.Full.Minutes)) to go</span>
                                    </div>
                                    <a class="small" href="shows/@c.ShowId#catch-up">
                                        <span class="tag tone-@CatchUpSection.Tone(c.Full.Verdict)">@(c.Full.Verdict is { } v ? char.ToUpperInvariant(v[0]) + v[1..] : "Plan")</span><span>@(" " + CatchUpSection.PerWeek(c.Full))</span>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </Feature>
        }

        @if (refreshers is { Count: > 0 })
        {
            <Feature Flag="@FeatureFlags.Refresher">
                <section class="back-after-break">
                    <h2>Back after a break</h2>
                    <ul class="up-next">
                        @foreach (var r in refreshers)
                        {
                            <li @key="r.ShowId">
                                <a href="shows/@r.ShowId"><Poster Title="@r.Title" Url="@r.PosterUrl" Size="small" /></a>
                                <div class="up-next-body">
                                    <a class="strong" href="shows/@r.ShowId">@r.Title</a>
                                    <div class="muted small">
                                        <span>Last watched @RefresherSection.Ago(r.DaysSince)</span>
                                        @if (r.Returns is { NewSeason: true } returns)
                                        {
                                            <span> · season @returns.SeasonNumber starts @Format.Relative(returns.PremieresAtUtc)</span>
                                        }
                                        else if (r.Ahead.Episodes > 0)
                                        {
                                            <span> · @(r.Ahead.Episodes == 1 ? "1 episode" : $"{r.Ahead.Episodes} episodes") to go</span>
                                        }
                                    </div>
                                    <a class="small" href="shows/@r.ShowId#previously-on">Previously on…: a @Format.Duration(r.PlanMinutes) refresher</a>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </Feature>
        }

        @if (items is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (items.Count == 0)
        {
            <p class="empty-state">You're all caught up. <a href="search">Find something new</a>.</p>
        }
        else
        {
            <ul class="up-next">
                @foreach (var item in items)
                {
                    <li>
                        <a href="shows/@item.ShowId"><Poster Title="@item.ShowTitle" Url="@item.PosterUrl" Size="small" /></a>
                        <div class="up-next-body">
                            <a class="strong" href="shows/@item.ShowId">@item.ShowTitle</a>
                            <div>
                                <a href="episodes/@item.Episode.EpisodeId">@Format.EpisodeCode(item.Episode.SeasonNumber, item.Episode.EpisodeNumber)</a><Spoiler Hidden="true">@(" · " + item.Episode.Title)</Spoiler>
                            </div>
                            <div class="muted small">
                                @if (item.HasAired)
                                {
                                    @(item.RemainingAired == 1 ? "1 episode to watch" : $"{item.RemainingAired} episodes to watch")
                                }
                                else
                                {
                                    <text>Airs <LocalTime Utc="item.Episode.AirsAtUtc" /></text>
                                }
                            </div>
                            <progress max="@Math.Max(1, item.AiredCount)" value="@item.WatchedCount"></progress>
                        </div>
                        @if (item.HasAired)
                        {
                            <button class="btn" @onclick="() => MarkWatchedAsync(item)" aria-label="Mark @item.ShowTitle @Format.EpisodeCode(item.Episode.SeasonNumber, item.Episode.EpisodeNumber) watched">✓ Watched</button>
                        }
                    </li>
                }
            </ul>
        }

        <section class="more-tools">
            <h2>More for your queue</h2>
            <div class="tool-links">
                <Feature Flag="@FeatureFlags.SpoilerWatch" ShowLocked>
                    <ToolLink Href="spoilers" Title="Spoiler watch">Which of your shows have spoilers about right now, and when it's safe again.</ToolLink>
                </Feature>
                <Feature Flag="@FeatureFlags.Streaks" ShowLocked>
                    <ToolLink Href="streaks" Title="Streaks">What to watch this week to keep your streaks going.</ToolLink>
                </Feature>
                <Feature Flag="@FeatureFlags.WaitingRoom" ShowLocked>
                    <ToolLink Href="waiting" Title="Waiting room">Shows you're caught up on, and when each is back.</ToolLink>
                </Feature>
                <Feature Flag="@FeatureFlags.TimeOff" ShowLocked>
                    <ToolLink Href="time-off" Title="Fits your time off">Finished shows you could watch whole in the days you've got.</ToolLink>
                </Feature>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to see the next episode of every show you're watching." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<UpNextItem>? items;
    private List<Refresher>? refreshers;
    private List<CatchUpPlan>? catchUps;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// Optional, like the refreshers.
    /// </summary>
    private async Task<List<CatchUpPlan>?> LoadCatchUpsAsync()
    {
        try
        {
            return await Analytics.GetCatchUpsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            return null;
        }
    }

    /// <summary>
    /// Optional: Up Next works without it (flag off, or Analytics unavailable).
    /// </summary>
    private async Task<List<Refresher>?> LoadRefreshersAsync()
    {
        try
        {
            return await Analytics.GetRefreshersAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            return null;
        }
    }

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            // All three start together, since none needs another's answer. The two panels answer with nothing
            // when Analytics fails or times out, so they don't take the list down.
            var itemsTask = Tracking.GetUpNextAsync();
            var refreshersTask = Flags.IfEnabledAsync(FeatureFlags.Refresher, LoadRefreshersAsync);
            var catchUpsTask = Flags.IfEnabledAsync(FeatureFlags.CatchUp, LoadCatchUpsAsync);
            // The list first: it is the page, and shows even if a panel's answer then fails some unexpected way.
            items = await itemsTask ?? [];
            await Task.WhenAll(refreshersTask, catchUpsTask);
            refreshers = refreshersTask.Result;
            catchUps = catchUpsTask.Result;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private async Task MarkWatchedAsync(UpNextItem item)
    {
        try
        {
            await Tracking.MarkWatchedAsync(new MarkWatched([item.Episode.EpisodeId], null, null, null, null));
            await LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
