@page "/search"
@implements IDisposable
@inject CatalogClient Catalog
@inject NavigationManager Navigation
@inject UserSession Session

<PageTitle>Search · @Brand.AppName</PageTitle>

<h1>Search</h1>

<form class="search-form" @onsubmit="SearchAsync">
    <input type="search" placeholder="A title, an actor, or what it's about" value="@query" @oninput="OnInput" aria-label="Search shows"
           autocomplete="off" />
    <select @bind="genre" aria-label="Genre">
        <option value="">All genres</option>
        @foreach (var g in genres)
        {
            <option value="@g">@g</option>
        }
    </select>
    <AuthorizeView>
        <select @bind="tag" aria-label="Tag">
            <option value="">Any kind of show</option>
            @foreach (var (key, label) in ShowTagOptions.All)
            {
                <option value="@key">@label</option>
            }
        </select>
    </AuthorizeView>
    <Feature Flag="@FeatureFlags.Nanogenres">
        @if (nanogenres.Count > 0)
        {
            <select @bind="nanogenre" aria-label="Nanogenre">
                <option value="">Any nanogenre</option>
                @foreach (var n in nanogenres.OrderBy(n => n.Name))
                {
                    <option value="@n.Slug">@n.Name (@n.ShowCount)</option>
                }
            </select>
        }
    </Feature>
    <button class="btn" type="submit" disabled="@searching">Search</button>
</form>

@if (suggestions is { Count: > 0 })
{
    @* As you type: shows already in the catalog, one click from their page. Enter searches properly, by meaning too. *@
    <ul class="show-picker-suggestions search-suggestions" aria-label="Suggestions">
        @foreach (var suggestion in suggestions)
        {
            <li>
                <a href="shows/@suggestion.Id">
                    <Poster Title="@suggestion.Title" Url="@suggestion.PosterUrl" Size="small" />
                    <span>
                        <span class="strong">@suggestion.Title</span>
                        <span class="muted small">@(suggestion.Year is { } year ? $" ({year})" : "")</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}

<ErrorNotice Message="@error" OnRetry="SearchAsync" />

@if (searching)
{
    @* A new search term can take a few seconds: matching shows are imported from TVmaze first. *@
    <p class="muted">Searching…</p>
}
else if (results is not null)
{
    @if (people.Count > 0)
    {
        <section aria-label="People">
            <h2>People</h2>
            <ul class="person-matches">
                @foreach (var person in people)
                {
                    <li>
                        <a href="people/@person.Id">
                            <span class="strong">@person.Name</span>
                            <span class="muted small">@string.Join(", ", person.KnownFor)</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (results.TotalCount == 0 && people.Count > 0)
    {
        <p class="muted">No shows by that name.</p>
    }
    else if (results.TotalCount == 0)
    {
        <p class="empty-state">
            @(string.IsNullOrWhiteSpace(resultsQuery) ? "No shows match those filters." : $"No shows found for “{resultsQuery}”.")
            Check the spelling, try fewer words, or describe it instead: “chemistry teacher turns to crime”.
        </p>
    }
    else
    {
        // By title first; what's left is similar in meaning, under its own heading so it doesn't read as a wrong answer.
        var byTitle = results.TitleCount ?? results.TotalCount;
        var titled = results.Items.Take(byTitle).ToList();
        var similar = results.Items.Skip(byTitle).ToList();
        <p class="muted">
            @(results.TitleCount is null ? Count(results.TotalCount, "result")
                : byTitle == 0 ? "No titles match; these are similar in meaning."
                : results.TotalCount == byTitle ? Count(byTitle, "result")
                : $"{Count(byTitle, "title match", "title matches")}, and {results.TotalCount - byTitle} similar in meaning")
        </p>
        @if (titled.Count > 0)
        {
            <div class="card-grid">
                @foreach (var show in titled)
                {
                    <ShowCard ShowId="show.Id" Title="@show.Title" PosterUrl="@show.PosterUrl" PreferredTag="@resultsTag" Subtitle="@Subtitle(show)" />
                }
            </div>
        }
        @if (similar.Count > 0)
        {
            @if (byTitle > 0)
            {
                <h2>Similar in meaning</h2>
            }
            <div class="card-grid">
                @foreach (var show in similar)
                {
                    <ShowCard ShowId="show.Id" Title="@show.Title" PosterUrl="@show.PosterUrl" PreferredTag="@resultsTag" Subtitle="@Subtitle(show)" />
                }
            </div>
        }
    }

    @if (results.TotalCount > results.Page * results.PageSize)
    {
        <button class="btn btn-quiet" @onclick="LoadMoreAsync">Load more</button>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? InitialQuery { get; set; }
    [SupplyParameterFromQuery(Name = "genre")] public string? InitialGenre { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? InitialTag { get; set; }
    [SupplyParameterFromQuery(Name = "nanogenre")] public string? InitialNanogenre { get; set; }

    private string? query;
    private string? genre;
    private string? tag;
    // The tag the results shown were filtered by (the dropdown may have changed since).
    private string? resultsTag;
    private List<string> genres = [];
    private string? nanogenre;
    private string? resultsNanogenre;
    private List<NanogenreSummary> nanogenres = [];
    private PagedResult<ShowSummary>? results;
    private List<ShowSummary> loaded = [];
    private string? error;
    private bool searching;
    // The term the results shown are for (the box may have changed since).
    private string? resultsQuery;
    private List<PersonMatch> people = [];
    private List<ShowSummary>? suggestions;
    private CancellationTokenSource? pending;

    private static string Count(int count, string one, string? many = null) => count == 1 ? $"1 {one}" : $"{count} {many ?? one + "s"}";

    private static string Subtitle(ShowSummary show) =>
        string.Join(" · ", new[] { show.Year?.ToString(), show.Network, Format.Status(show.Status) }.Where(s => !string.IsNullOrEmpty(s)));

    private async Task OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString();
        pending?.Cancel();
        pending = new CancellationTokenSource();
        var ct = pending.Token;
        try
        {
            // Wait for a pause in typing, so suggestions follow the term rather than every keystroke.
            await Task.Delay(250, ct);
            suggestions = query?.Trim().Length >= 2 ? await Catalog.SuggestAsync(query.Trim(), ct) : null;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke, or by the search itself.
        }
        catch (HttpRequestException)
        {
            suggestions = null;
        }
    }

    public void Dispose() => pending?.Cancel();

    protected override async Task OnInitializedAsync()
    {
        query = InitialQuery;
        genre = InitialGenre;
        nanogenre = InitialNanogenre;
        await Session.EnsureLoadedAsync();
        // The tag filter is for signed-in users (the API refuses it otherwise); a shared ?tag= link just searches without it.
        tag = Session.IsSignedIn ? InitialTag : null;
        try
        {
            genres = await Catalog.GetGenresAsync() ?? [];
            nanogenres = await Catalog.GetNanogenresAsync() ?? [];
        }
        catch (HttpRequestException)
        {
            // Genre filter is optional.
        }
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        error = null;
        searching = true;
        pending?.Cancel();
        suggestions = null;
        try
        {
            var term = query?.Trim();
            // People alongside the shows; a search without them is still a search.
            var peopleTask = term?.Length >= 3 ? PeopleAsync(term) : Task.FromResult<List<PersonMatch>>([]);
            results = await Catalog.SearchAsync(query, genre, tag: tag, nanogenre: nanogenre);
            (people, resultsQuery) = (await peopleTask, term);
            resultsTag = string.IsNullOrWhiteSpace(tag) ? null : tag;
            resultsNanogenre = string.IsNullOrWhiteSpace(nanogenre) ? null : nanogenre;
            loaded = results?.Items.ToList() ?? [];
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["q"] = string.IsNullOrWhiteSpace(query) ? null : query,
                ["genre"] = string.IsNullOrWhiteSpace(genre) ? null : genre,
                ["tag"] = string.IsNullOrWhiteSpace(tag) ? null : tag,
                ["nanogenre"] = string.IsNullOrWhiteSpace(nanogenre) ? null : nanogenre
            }), replace: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
        finally
        {
            searching = false;
        }
    }

    private async Task<List<PersonMatch>> PeopleAsync(string term)
    {
        try
        {
            return await Catalog.SearchPeopleAsync(term) ?? [];
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }

    private async Task LoadMoreAsync()
    {
        if (results is null)
        {
            return;
        }

        var next = await Catalog.SearchAsync(resultsQuery, genre, results.Page + 1, resultsTag, resultsNanogenre);
        if (next is not null)
        {
            loaded.AddRange(next.Items);
            results = next with { Items = loaded.ToList(), Page = next.Page };
        }
    }
}
