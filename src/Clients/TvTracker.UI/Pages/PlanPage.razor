@page "/settings/plan"
@attribute [RequiresFeature(FeatureFlags.Plans)]
@inject IdentityClient Identity
@inject FeatureFlagStore Flags
@inject NavigationManager Navigation

<PageTitle>Your plan · @Brand.AppName</PageTitle>

<p><a href="settings">← Settings</a></p>
<h1>Your plan</h1>

<AuthorizeView>
    <Authorized>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />
        @if (plan is null)
        {
            @if (error is null)
            {
                <p class="muted">Loading…</p>
            }
        }
        else
        {
            <p>
                You're on <strong>@plan.Name</strong>@(plan.ChangedAtUtc is { } changed ? $" since {changed:d MMM yyyy}" : "")@(plan.Plan == Plans.Family && plan.Purchased != Plans.Family ? ", through a family you're in" : "").
            </p>

            <Feature Flag="@FeatureFlags.Payments">
                @if (subscription is { Active: true } sub)
                {
                    <section class="panel">
                        <p>
                            <span>@($"{Plans.Name(sub.Plan)} by the {sub.Interval}, ")</span>
                            <strong>@($"{(sub.CancelAtPeriodEnd ? "ends" : "renews")} on {sub.CurrentPeriodEndUtc:d MMM yyyy}")</strong>
                            <span>.</span>
                        </p>
                        @if (sub.CancelAtPeriodEnd)
                        {
                            <p class="muted small">You keep @Plans.Name(sub.Plan) until then, and go back to @Plans.Name(Plans.Free) after; nothing you made goes.</p>
                            <button class="btn" @onclick="ResumeAsync" disabled="@busy">Keep @Plans.Name(sub.Plan)</button>
                        }
                        else
                        {
                            <button class="btn secondary" @onclick="CancelAsync" disabled="@busy">Cancel</button>
                        }
                        @if (sub.ManageUrl is { } manage)
                        {
                            @* The test provider's page is in the web app (a relative address); a real provider's is its own site. *@
                            @if (!Uri.IsWellFormedUriString(manage, UriKind.Absolute))
                            {
                                <p class="muted small"><a href="@manage">The test provider's page</a> renews or ends it now.</p>
                            }
                            else
                            {
                                <p class="muted small"><a href="@manage" target="_blank" rel="noopener">Manage billing</a>: your card and invoices.</p>
                            }
                        }
                    </section>
                }
            </Feature>

            @* Both columns come from the shared Plans limits, so this table says what the services enforce. *@
            <div class="plan-grid">
                @foreach (var key in Plans.All)
                {
                    var limits = Plans.Limits(key);
                    <section class="panel plan-card @(key == plan.Plan ? "current" : "")">
                        <h2>@Plans.Name(key)</h2>
                        <ul class="plan-features">
                            <li>@(limits.MaxLists is { } max ? $"Up to {max} lists" : "As many lists as you like")</li>
                            <li>@(limits.ShareLists ? "Share lists on your profile or by link" : "Lists are just for you")</li>
                            @if (limits.TrackServices)
                            {
                                <Feature Flag="@FeatureFlags.YourServices">
                                    <li>Your services: what each streaming service costs per hour you watch</li>
                                </Feature>
                            }
                            @if (key == Plans.Family)
                            {
                                <li>@($"Shared with up to {Plans.FamilyMembers} people you invite")</li>
                            }
                            @* Family has Pro's features, said once below, not listed again. *@
                            @if (features is not null && key != Plans.Family)
                            {
                                var mine = features.Where(f => f.Plans.Contains(key)).ToList();
                                @if (mine.Count > 0)
                                {
                                    <li>
                                        <span>@(mine.Count == 1 ? "1 more insight: " : $"{mine.Count} more insights: ")</span>
                                        <span class="muted">@string.Join(", ", mine.Select(f => f.Name))</span>
                                    </li>
                                }
                            }
                            <li>@(key == Plans.Free ? "Tracking, ratings, lists and the basic insights"
                                : key == Plans.Family ? $"Everything in {Plans.Name(Plans.Plus)}" : $"Everything in {Plans.Name(Plans.Free)}")</li>
                        </ul>
                        @if (key == plan.Plan)
                        {
                            <p class="tag">Your plan</p>
                        }
                        else if (key != Plans.Free && CanBuy && prices is not null)
                        {
                            <Feature Flag="@FeatureFlags.Payments">
                                <div class="plan-buy">
                                    @foreach (var interval in new[] { "month", "year" })
                                    {
                                        var price = prices.For(key, interval);
                                        <button class="btn @(interval == "year" ? "secondary" : "")" @onclick="() => BuyAsync(key, interval)" disabled="@busy">
                                            @($"{Money(price)} a {interval}")
                                        </button>
                                    }
                                </div>
                            </Feature>
                        }
                    </section>
                }
            </div>

            <Feature Flag="@FeatureFlags.FamilyPlan">
                <p><a href="settings/family">Your family</a><span class="muted small">@(plan.Purchased == Plans.Family ? " · invite people to share your plan" : " · join a family, or see who's in yours")</span></p>
            </Feature>
            @if (plan.Plan == Plans.Free && prices?.Provider is null)
            {
                <p class="muted small">Plans can't be bought here yet. Until they can, an admin can move you to @Plans.Name(Plans.Plus) or @Plans.Name(Plans.Family), or someone on @Plans.Name(Plans.Family) can invite you.</p>
            }
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt />
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserPlan? plan;
    private IReadOnlyList<PlanFeature>? features;
    private PlanPrices? prices;
    private PlanSubscription? subscription;
    private bool busy;
    private string? error;

    /// <summary>
    /// A plan can be bought when a provider sells them and no subscription is running (switching is cancel, then buy).
    /// </summary>
    private bool CanBuy => prices?.Provider is not null && subscription is not { Active: true };

    private string Money(decimal amount) => prices!.Currency == "USD"
        ? Format.Usd(amount)
        : $"{prices.Currency} {amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            // Two rounds: the plan, the flag and the plans' insights together, then prices and subscription together.
            var planTask = Identity.GetMyPlanAsync();
            var paymentsTask = Flags.IsEnabledAsync(FeatureFlags.Payments);
            // Which insights each plan has comes from the flags (flagd.json and the flags page), not from code.
            var featuresTask = Flags.PlanFeaturesAsync();
            if (await paymentsTask)
            {
                var pricesTask = Identity.GetPlanPricesAsync();
                var subscriptionTask = Identity.GetSubscriptionAsync();
                await Task.WhenAll(pricesTask, subscriptionTask);
                (prices, subscription) = (pricesTask.Result, subscriptionTask.Result);
            }
            plan = await planTask;
            features = await featuresTask;
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private Task BuyAsync(string key, string interval) => RunAsync(async () =>
    {
        if (await Identity.StartCheckoutAsync(key, interval) is { } link)
        {
            // The provider's checkout is another site; it sends the buyer back to this page.
            Navigation.NavigateTo(link.Url, forceLoad: true);
        }
    });

    private Task CancelAsync() => RunAsync(async () => subscription = await Identity.CancelSubscriptionAsync());

    private Task ResumeAsync() => RunAsync(async () => subscription = await Identity.ResumeSubscriptionAsync());

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
        finally
        {
            busy = false;
        }
    }
}
