@page "/settings/affiliates"
@attribute [RequiresFeature(FeatureFlags.Affiliates)]
@inject CatalogClient Catalog

<PageTitle>Affiliate links · @Brand.AppName</PageTitle>

<p><a href="settings">← Settings</a></p>
<h1>Affiliate links</h1>

<AuthorizeView>
    <Authorized>
        <p class="muted">
            Every where-to-watch click on a show page, counted before the viewer is sent on, and the sales affiliate networks
            report back. Clicks keep the show, service, region, plan and where the link was, nothing about who.
        </p>

        <div class="actions" role="group" aria-label="Window">
            @foreach (var option in Windows)
            {
                <button class="btn @(days == option ? "" : "btn-quiet")" aria-pressed="@(days == option)" @onclick="() => SetDaysAsync(option)">
                    @($"{option} days")
                </button>
            }
        </div>

        <ErrorNotice Message="@error" OnRetry="LoadAsync" />
        @if (report is null)
        {
            @if (error is null)
            {
                <p class="muted">@(loaded ? "Only admins can see affiliate links." : "Loading…")</p>
            }
        }
        else
        {
            <p class="muted small">@($"{report.From:d MMM yyyy} to {report.To:d MMM yyyy}, UTC.")</p>
            <div class="stat-tiles">
                <div class="stat"><div class="stat-value">@report.Clicks.ToString("N0")</div><div class="muted">clicks out</div></div>
                <div class="stat">
                    <div class="stat-value">@Share(report.AffiliatedClicks, report.Clicks)</div>
                    <div class="muted">@($"through a program ({report.AffiliatedClicks:N0})")</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@report.Conversions.ToString("N0")</div>
                    <div class="muted">@($"sales reported, {Share(report.Conversions, report.AffiliatedClicks)} of program clicks")</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@(report.Revenue.Count == 0 ? "–" : string.Join(" + ", report.Revenue.Select(m => Amount(m.Amount, m.Currency))))</div>
                    <div class="muted">commission</div>
                </div>
            </div>

            @if (report.Clicks == 0)
            {
                <p class="muted">No where-to-watch clicks in this window yet.</p>
            }
            else
            {
                <section>
                    <h2>By day</h2>
                    <ul class="bars wide-values">
                        @foreach (var day in report.Days.Where(d => d.Clicks > 0 || d.Conversions > 0))
                        {
                            <li>
                                <span>@day.Day.ToString("ddd d MMM")</span>
                                <span class="bar" style="width: @Width(day.Clicks, maxDay)%"></span>
                                <span>@(day.Conversions > 0 ? $"{day.Clicks} · {day.Conversions} sold" : day.Clicks.ToString())</span>
                            </li>
                        }
                    </ul>
                </section>

                <section>
                    <h2>By service</h2>
                    <div class="table-scroll">
                        <table class="table wide">
                            <thead>
                                <tr><th>Service</th><th>Program</th><th>Clicks</th><th>Sales</th><th>Rate</th><th>Commission</th><th>Per click</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var row in report.Services)
                                {
                                    <tr>
                                        <td>@row.Service</td>
                                        <td>@(row.Program ?? "none")</td>
                                        <td>@row.Clicks.ToString("N0")</td>
                                        <td>@(row.Program is null ? "–" : row.Conversions.ToString("N0"))</td>
                                        <td>@(row.ConversionRate is { } rate ? rate.ToString("P1") : "–")</td>
                                        <td>@(row.Program is null ? "–" : Amount(row.Revenue, row.Currency))</td>
                                        <td>@(row.EarningsPerClick is { } epc ? Amount(epc, row.Currency, 3) : "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Unmonetised is { Count: > 0 } open)
                    {
                        <p class="muted small">
                            @($"Worth a program: {string.Join(", ", open.Select(r => $"{r.Service} ({r.Clicks:N0} clicks)"))} sent people on without one.")
                        </p>
                    }
                </section>

                <section>
                    <h2>Where the clicks come from</h2>
                    <div class="table-scroll">
                        <table class="table">
                            <thead><tr><th>Link</th><th>Clicks</th><th>Sales</th></tr></thead>
                            <tbody>
                                @foreach (var row in report.Surfaces)
                                {
                                    <tr><td>@SurfaceName(row.Key)</td><td>@row.Clicks.ToString("N0")</td><td>@row.Conversions.ToString("N0")</td></tr>
                                }
                            </tbody>
                        </table>
                        <table class="table">
                            <thead><tr><th>Viewer's plan</th><th>Clicks</th><th>Sales</th></tr></thead>
                            <tbody>
                                @foreach (var row in report.Plans)
                                {
                                    <tr><td>@PlanName(row.Key)</td><td>@row.Clicks.ToString("N0")</td><td>@row.Conversions.ToString("N0")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section>
                    <h2>Shows sending the most</h2>
                    <ol class="plain-list">
                        @foreach (var show in report.Shows)
                        {
                            <li>
                                <a href="shows/@show.ShowId">@show.Title</a>
                                <span class="muted">@($" · {show.Clicks:N0} clicks{(show.Conversions > 0 ? $", {show.Conversions} sold" : "")}")</span>
                            </li>
                        }
                    </ol>
                </section>
            }

            <section>
                <h2>Programs</h2>
                @if (report.Programs.Count == 0)
                {
                    <p class="muted">
                        None yet: every click goes to the service's own link and is still counted, so the table above is what each
                        service's traffic is worth to a deal.
                    </p>
                }
                else
                {
                    <ul class="plain-list">
                        @foreach (var program in report.Programs)
                        {
                            <li>
                                <strong>@program.Name</strong>
                                <span class="muted">@($" · {string.Join(", ", program.Services)} · {(program.Regions.Count == 0 ? "every region" : string.Join(", ", program.Regions))} · paid in {program.Currency}")</span>
                                @if (!program.Valid)
                                {
                                    <span class="tag tone-bad">@("not used: check its name, services, currency and https template")</span>
                                }
                            </li>
                        }
                    </ul>
                }
                <p class="muted small">
                    Programs are set in Catalog.API's <code>Affiliates:Programs</code> (name, services, regions, an https template with
                    <code>{url}</code> and <code>{click}</code>, a postback key and currency). Networks report sales to
                    <code>/catalog/api/v1/affiliates/postback/{name}?click=…&amp;transaction=…&amp;amount=…&amp;key=…</code> on the mobile
                    gateway's public address.
                </p>
            </section>
        }
    </Authorized>
    <NotAuthorized>
        <p class="muted">Sign in as an admin to see affiliate links.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly int[] Windows = [7, 30, 90];

    private AffiliateReport? report;
    private int days = 30;
    private bool loaded;
    private string? error;

    private int maxDay => report?.Days.Select(d => d.Clicks).DefaultIfEmpty(0).Max() ?? 0;

    /// <summary>Services that sent clicks with no program covering them, most first.</summary>
    private List<AffiliateServiceRow>? Unmonetised =>
        report?.Services.Where(s => s.Program is null && s.Clicks > 0).OrderByDescending(s => s.Clicks).Take(5).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SetDaysAsync(int value)
    {
        days = value;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            report = await Catalog.GetAffiliateReportAsync(days);
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
        finally
        {
            loaded = true;
        }
    }

    private static int Width(int value, int max) => max == 0 ? 0 : Math.Max(2, (int)Math.Round(100.0 * value / max));

    private static string Share(int part, int whole) => whole == 0 ? "–" : ((double)part / whole).ToString("P0");

    private static string Amount(decimal amount, string? currency, int decimals = 2) =>
        $"{amount.ToString($"N{decimals}")} {currency}".Trim();

    private static string SurfaceName(string key) => key switch
    {
        "watch-now" => "Show page: Watch on …",
        "where-to-watch" => "Show page: Where to watch",
        _ => key
    };

    private static string PlanName(string key) => key switch
    {
        "signed-out" => "Signed out",
        "unknown" => "Signed in (plans off)",
        _ => char.ToUpperInvariant(key[0]) + key[1..]
    };
}
