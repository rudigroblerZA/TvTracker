@page "/shows"

<PageTitle>@(ShowingCalendar ? "Calendar · " : "")My shows · @Brand.AppName</PageTitle>

<h1>My shows</h1>

<AuthorizeView>
    <Authorized>
        @* Two views of the shows you follow: the shows themselves, and when their episodes air. The address holds which,
           so the calendar can be linked to and bookmarked. Each view loads its own data when it is shown. *@
        <div class="segmented" role="group" aria-label="View">
            <a class="btn @(ShowingCalendar ? "btn-quiet" : "")" href="shows" aria-current="@(ShowingCalendar ? null : "page")">Shows</a>
            <a class="btn @(ShowingCalendar ? "" : "btn-quiet")" href="@CalendarHref" aria-current="@(ShowingCalendar ? "page" : null)">Calendar</a>
        </div>

        @if (ShowingCalendar)
        {
            <CalendarView />
        }
        else
        {
            <FollowedShowsView />
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="@(ShowingCalendar ? "Sign in to see when your shows air, in your timezone." : "Sign in to see the shows you follow.")" />
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Where the calendar view is, for links to it.
    /// </summary>
    public const string CalendarHref = "shows?view=calendar";

    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private bool ShowingCalendar => string.Equals(View, "calendar", StringComparison.OrdinalIgnoreCase);
}
