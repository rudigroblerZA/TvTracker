@page "/shows"
@inject NotificationsClient Notifications
@inject UserSession Session

<PageTitle>@(Current switch { Calendar => "Calendar · ", Feed => "Feed · ", Inbox => "Inbox · ", _ => "" })My shows · @Brand.AppName</PageTitle>

<h1>My shows</h1>

<AuthorizeView>
    <Authorized>
        @* Four views of the shows you follow: the shows themselves, when their episodes air, what the people you
           follow did with theirs, and what you've been told about them. The address holds which, so each can be
           linked to and bookmarked. Each view loads its own data when it is shown. *@
        <div class="segmented" role="group" aria-label="View">
            <a class="btn @Quiet(Shows)" href="shows" aria-current="@Page(Shows)">Shows</a>
            <a class="btn @Quiet(Calendar)" href="@CalendarHref" aria-current="@Page(Calendar)">Calendar</a>
            <Feature Flag="@FeatureFlags.Social">
                <a class="btn @Quiet(Feed)" href="@FeedHref" aria-current="@Page(Feed)">Feed</a>
            </Feature>
            <a class="btn @Quiet(Inbox)" href="@InboxHref" aria-current="@Page(Inbox)">
                <span>Inbox</span>
                @if (unread > 0)
                {
                    <span class="count" aria-label="@($"{unread} unread")">@unread</span>
                }
            </a>
        </div>

        @switch (Current)
        {
            case Calendar:
                <CalendarView />
                break;
            case Feed:
                <Feature Flag="@FeatureFlags.Social"><FeedView /></Feature>
                break;
            case Inbox:
                <InboxView UnreadChanged="count => unread = count" />
                break;
            default:
                <FollowedShowsView />
                break;
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="@(Current switch
        {
            Calendar => "Sign in to see when your shows air, in your timezone.",
            Feed => "Sign in to follow people and see what they watch.",
            Inbox => "Sign in to see your notifications.",
            _ => "Sign in to see the shows you follow."
        })" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string Shows = "shows", Calendar = "calendar", Feed = "feed", Inbox = "inbox";

    /// <summary>
    /// Where the calendar view is, for links to it.
    /// </summary>
    public const string CalendarHref = "shows?view=calendar";

    /// <summary>
    /// Where the feed view is, for links to it.
    /// </summary>
    public const string FeedHref = "shows?view=feed";

    /// <summary>
    /// Where the inbox view is, for links to it.
    /// </summary>
    public const string InboxHref = "shows?view=inbox";

    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    // Shown on the Inbox button, since the inbox is no longer in the menu. The inbox view keeps it current.
    private int unread;

    private string Current => View?.ToLowerInvariant() switch { Calendar => Calendar, Feed => Feed, Inbox => Inbox, _ => Shows };

    private string Quiet(string view) => Current == view ? "" : "btn-quiet";

    private string? Page(string view) => Current == view ? "page" : null;

    protected override async Task OnInitializedAsync()
    {
        // The inbox view loads the inbox itself and reports the count.
        if (Current == Inbox)
        {
            return;
        }
        await Session.EnsureLoadedAsync();
        if (!Session.IsSignedIn)
        {
            return;
        }
        try
        {
            unread = await Notifications.GetUnreadCountAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            // The count is a hint; the inbox view says what went wrong.
        }
    }
}
