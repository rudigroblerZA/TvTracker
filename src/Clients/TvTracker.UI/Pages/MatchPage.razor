@page "/match/{Token}"
@attribute [RequiresFeature(FeatureFlags.TasteMatch)]
@inject AnalyticsClient Analytics
@inject CatalogClient Catalog
@inject IPlatformServices Platform
@inject NavigationManager Navigation
@inject UserSession Session
@inject TrackingClient Tracking

<PageTitle>@(match?.Result is { } r ? $"{r.Score}% match" : "Taste Match") · @Brand.AppName</PageTitle>

<ErrorNotice Message="@error" />

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (match is null)
{
    <h1>Taste Match</h1>
    <p>This match is no longer open: the link has expired or the match was deleted.</p>
    <p><a class="btn" href="match">Start one of your own</a></p>
}
else if (match.Result is { } result)
{
    <MatchResult Result="result" Inviter="@(match.InviterName ?? "Your friend")" Friend="@(match.FriendName ?? "A friend")" You="@You" />

    @if (CanKeep)
    {
        @* Asked, never done on arrival: a link with a key in it must not put a match on the account of whoever opens it. *@
        <div class="panel">
            <p><strong>Is this the match you just answered?</strong> Keep it on your account, with the shows you picked.</p>
            <div class="actions">
                <button class="btn" type="button" @onclick="KeepAsync" disabled="@busy">Keep this match</button>
            </div>
        </div>
    }

    @if (claimed is { Count: > 0 })
    {
        <div class="panel">
            <p><strong>This match is now on your account.</strong> Follow the shows you picked, so @Brand.AppName keeps your place in them?</p>
            <p class="muted small">@string.Join(", ", claimed.Select(p => p.Title))</p>
            <div class="actions">
                @if (followedPicks)
                {
                    <span>Following @claimed.Count @(claimed.Count == 1 ? "show" : "shows"). <a href="shows">See My shows</a></span>
                }
                else
                {
                    <button class="btn" type="button" @onclick="FollowPicksAsync" disabled="@busy">Follow @(claimed.Count == 1 ? "it" : $"all {claimed.Count}")</button>
                }
            </div>
        </div>
    }

    <div class="match-card">
        <img src="@CardUrl("link")" alt="@($"{result.Score}% TV taste match")" width="1200" height="630" loading="lazy" />
        <a class="btn btn-quiet small" href="@CardUrl("story")" download="taste-match.png">Save the picture for stories</a>
    </div>

    <div class="actions">
        <button class="btn" type="button" @onclick="ShareAsync">@(copied ? "Copied" : "Share this match")</button>
        <a class="btn btn-quiet" href="match">Match with someone else</a>
        @if (match.OtherUserId is { } other)
        {
            <Feature Flag="@FeatureFlags.TonightTogether">
                <a class="btn btn-quiet" href="tonight?with=@Uri.EscapeDataString(other)">Plan an evening together</a>
            </Feature>
        }
        @if (match.You is not null || guestKey is not null)
        {
            <button class="link small" type="button" @onclick="DeleteAsync">Delete this match</button>
        }
    </div>
    @if (!Session.IsSignedIn)
    {
        <p class="panel">
            <strong>Keep track of what you watch.</strong> @Brand.AppName remembers where you are in every show and tells you when they're back.
            <a href="account/login?returnUrl=@Uri.EscapeDataString(AfterSignIn)">Make an account</a>
            @if (guestKey is not null)
            {
                <span class="muted small">Your match and your picks come with you.</span>
            }
        </p>
    }
}
else if (match.You == "inviter")
{
    <h1>Waiting for your friend</h1>
    <p class="muted">The result appears here as soon as they've answered.</p>
    <div class="actions">
        <input class="list-link-url" readonly value="@Link" aria-label="Your match link" />
        <button class="btn" type="button" @onclick="ShareAsync">@(copied ? "Copied" : "Share link")</button>
        <button class="link small" type="button" @onclick="DeleteAsync">Cancel this match</button>
    </div>
}
else if (Session.IsSignedIn)
{
    <h1>@(match.InviterName ?? "Your friend") wants to match TV taste with you</h1>
    <p>Use the shows you rate highly, follow and watch? You both get a score, what you have in common, and shows to watch together.</p>
    <MatchNameable Shows="match.Nameable ?? []" Unnamed="unnamed" />
    <div class="actions">
        <button class="btn" type="button" @onclick="AcceptAsync" disabled="@busy">See your match</button>
    </div>
}
else
{
    <h1>@(match.InviterName ?? "Your friend") wants to match TV taste with you</h1>
    <p>Pick @(MinPicks) or more shows you love. No account needed.</p>

    <ShowPicker Label="Search for a show" Selected="null" SelectedChanged="Add" ExcludeAll="picks.Select(p => p.Id).ToList()" />

    @if (picks.Count > 0)
    {
        <div class="tags match-picks" aria-label="Your picks">
            @foreach (var pick in picks)
            {
                <button class="tag" type="button" @key="pick.Id" @onclick="() => Remove(pick)" title="Remove">@pick.Title ✕</button>
            }
        </div>
    }

    @* Stays in reach while the grid below is scrolled. *@
    <div class="actions match-answer">
        <input type="text" maxlength="30" placeholder="Your first name (optional)" aria-label="Your first name" @bind="name" />
        <button class="btn" type="button" @onclick="AnswerAsync" disabled="@(busy || picks.Count < MinPicks)">
            @(picks.Count < MinPicks ? $"Pick {MinPicks - picks.Count} more" : "See your match")
        </button>
        <a class="small" href="account/login?returnUrl=@Uri.EscapeDataString($"/match/{Token}")">Already a member? Sign in</a>
    </div>

    @if (popular is { Count: > 0 })
    {
        <h2>Or tap the ones you love</h2>
        <div class="card-grid match-popular">
            @foreach (var show in popular)
            {
                var picked = picks.Any(p => p.Id == show.Id);
                <button class="show-card match-tap @(picked ? "picked" : "")" type="button" @key="show.Id" aria-pressed="@picked"
                        @onclick="() => { if (picked) { Remove(show); } else { Add(show); } }">
                    <Poster Title="@show.Title" Url="@show.PosterUrl" />
                    <span class="show-card-title">@(picked ? "✓ " : "")@show.Title</span>
                </button>
            }
        </div>
    }
}

@code {
    // The server's limits, sent with the match.
    private int MinPicks => match?.MinPicks ?? 3;
    private int MaxPicks => match?.MaxPicks ?? 8;

    [Parameter] public string Token { get; set; } = "";

    /// <summary>
    /// A guest's key, carried through sign-in so the match they answered can be attached to the account they made.
    /// </summary>
    [SupplyParameterFromQuery(Name = "key")] public string? Key { get; set; }

    private MatchView? match;
    private bool loaded;
    private bool busy;
    private bool copied;
    private string? error;
    private string? name;
    private string? guestKey;
    private List<ShowSummary>? popular;
    private readonly List<ShowSummary> picks = [];
    private readonly HashSet<Guid> unnamed = [];
    private IReadOnlyList<MatchShow>? claimed;
    private bool followedPicks;
    private bool kept;

    // Back to this match after signing in or up, with the key that lets a guest keep it.
    private string AfterSignIn => guestKey is null ? "/match" : $"/match/{Token}?key={Uri.EscapeDataString(guestKey)}";

    // A guest back from making an account, with the key they were given: they may keep the match, if they say so.
    private bool CanKeep => claimed is null && !kept && match is { Result: not null, You: null } && Session.IsSignedIn && !string.IsNullOrEmpty(Key);

    private string Link => $"{Platform.PublicWebAddress}match/{Token}";

    // The card is the site's to serve (it is also what a pasted link shows), so its address is absolute: in the mobile
    // app a relative one would point at the app itself.
    private string CardUrl(string size) => $"{Link}/card.png?size={size}";

    // Which of the two is looking, when that's known: a member the match names, or the guest who just answered.
    private string? You => match?.You ?? (guestKey is not null ? "friend" : null);

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        await RunAsync(async () =>
        {
            match = await Analytics.GetMatchAsync(Token);
            if (match is { Result: null } && !Session.IsSignedIn)
            {
                popular = await Catalog.GetTrendingAsync() ?? [];
            }
        });
        loaded = true;
    }

    private void Add(ShowSummary? show)
    {
        if (show is not null && picks.Count < MaxPicks && picks.All(p => p.Id != show.Id))
        {
            picks.Add(show);
        }
    }

    private void Remove(ShowSummary show) => picks.RemoveAll(p => p.Id == show.Id);

    private Task AnswerAsync() => RunAsync(async () =>
    {
        var answered = await Analytics.AnswerMatchAsGuestAsync(Token, picks.Select(p => p.Id).ToList(), name);
        guestKey = answered?.GuestKey;
        // Someone else answered first, or the link has gone: show what's there now.
        match = answered ?? await Analytics.GetMatchAsync(Token);
    });

    private Task AcceptAsync() => RunAsync(async () => match = await Analytics.AcceptMatchAsync(Token, unnamed) ?? await Analytics.GetMatchAsync(Token));

    private Task KeepAsync() => RunAsync(async () =>
    {
        kept = true;
        if (await Analytics.ClaimMatchAsync(Token, Key!) is { } mine)
        {
            (match, claimed) = (mine.Match, mine.Picks);
        }
        else
        {
            error = "This match can't be kept: it is already on an account, or the link isn't the one you answered from.";
        }
    });

    private Task FollowPicksAsync() => RunAsync(async () =>
    {
        await Task.WhenAll((claimed ?? []).Select(pick => Tracking.FollowAsync(pick.ShowId, from: FollowSources.Match)));
        followedPicks = true;
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Analytics.DeleteMatchAsync(Token, guestKey);
        Navigation.NavigateTo(Session.IsSignedIn ? "match" : "");
    });

    private async Task ShareAsync() =>
        copied = await Platform.ShareLinkAsync(
            match?.Result is { } result ? $"{result.Score}% TV taste match on {Brand.AppName}" : $"Match your TV taste with mine on {Brand.AppName}", Link);

    private async Task RunAsync(Func<Task> action)
    {
        error = null;
        busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
        finally
        {
            busy = false;
        }
    }
}
