@page "/stats"
@inject TrackingClient Tracking
@inject AnalyticsClient Analytics
@inject UserSession Session

<PageTitle>Stats · @Brand.AppName</PageTitle>

<h1>Your stats</h1>

<AuthorizeView>
    <Authorized>
        <div class="tool-links">
            <Feature Flag="@FeatureFlags.YearInTv">
                <ToolLink Href="year" Title="Your year in TV">Your top shows, rhythm, highlights and how your taste moved.</ToolLink>
            </Feature>
        </div>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        @if (stats is null)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            <div class="stat-tiles">
                <div class="stat"><div class="stat-value">@Format.Duration(stats.MinutesWatched)</div><div class="muted">watched</div></div>
                <div class="stat"><div class="stat-value">@stats.EpisodesWatched</div><div class="muted">episodes</div></div>
                <div class="stat"><div class="stat-value">@stats.ShowsFollowed</div><div class="muted">shows followed</div></div>
                <div class="stat"><div class="stat-value">@stats.ShowsCompleted</div><div class="muted">shows completed</div></div>
            </div>

            @if (stats.TopGenres.Count > 0)
            {
                <section>
                    <h2>Top genres</h2>
                    @{ var max = stats.TopGenres.Max(g => g.Episodes); }
                    <ul class="bars">
                        @foreach (var genre in stats.TopGenres)
                        {
                            <li>
                                <span class="bar-label">@genre.Genre</span>
                                <span class="bar" style="width:@(100 * genre.Episodes / max)%"></span>
                                <span class="muted small">@genre.Episodes</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (stats.Years.Count > 0)
            {
                <section>
                    <h2>Year in review</h2>
                    <table class="table">
                        <thead><tr><th>Year</th><th>Episodes</th><th>Time</th><th>New shows</th></tr></thead>
                        <tbody>
                            @foreach (var year in stats.Years)
                            {
                                <tr>
                                    <td>@year.Year</td>
                                    <td>@year.Episodes</td>
                                    <td>@Format.Duration(year.Minutes)</td>
                                    <td>@year.ShowsStarted</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        }

        @if (taste is not null)
        {
            <section>
                <h2>Your taste</h2>

                @if (taste.Bias is { } bias)
                {
                    <p>
                        <span class="tag">@BiasLabel(bias)</span>
                        @BiasText(bias)
                    </p>
                    @if (bias.Kinder.Count > 0 || bias.Harsher.Count > 0)
                    {
                        <div class="taste-compare">
                            @if (bias.Kinder.Count > 0)
                            {
                                <div>
                                    <div class="muted small">You liked more than TVmaze</div>
                                    <ul class="shared-cast">
                                        @foreach (var show in bias.Kinder)
                                        {
                                            <li><a href="shows/@show.ShowId">@show.Title</a> <span class="muted small">★ @show.Stars vs @Format.Rating(show.ExternalRating)</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (bias.Harsher.Count > 0)
                            {
                                <div>
                                    <div class="muted small">You liked less than TVmaze</div>
                                    <ul class="shared-cast">
                                        @foreach (var show in bias.Harsher)
                                        {
                                            <li><a href="shows/@show.ShowId">@show.Title</a> <span class="muted small">★ @show.Stars vs @Format.Rating(show.ExternalRating)</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="muted">Rate a few more shows or episodes to see how your taste compares with TVmaze's.</p>
                }

                @if (taste.Genres.Count > 0)
                {
                    <h3>Genres you rate highest</h3>
                    <ul class="bars wide-values">
                        @foreach (var genre in taste.Genres)
                        {
                            <li>
                                <span class="bar-label">@genre.Genre</span>
                                <span class="bar" style="width:@((int)Math.Round(100 * genre.AverageStars / 5))%"></span>
                                <span class="muted small nowrap" title="@genre.Rated shows rated">★ @genre.AverageStars.ToString("0.0") (@genre.Rated)</span>
                            </li>
                        }
                    </ul>
                }

                @if (taste.Months.Any(m => m.Minutes > 0))
                {
                    <h3>The last 12 months</h3>
                    var most = Math.Max(1, taste.Months.Max(m => m.Minutes));
                    <div class="columns" aria-label="Time watched per month">
                        @foreach (var month in taste.Months)
                        {
                            <div class="column" title="@MonthName(month): @month.Episodes episodes, @Format.Duration(month.Minutes)">
                                <span style="height:@(100 * month.Minutes / most)%"></span>
                                <span class="column-label">@MonthName(month)[..1]</span>
                            </div>
                        }
                    </div>
                }

                <Feature Flag="@FeatureFlags.Forecasts">
                    @if (finishing is { Count: > 0 })
                    {
                        <h3>Will you finish them?</h3>
                        <ul class="finish-list">
                            @foreach (var outlook in finishing)
                            {
                                <li @key="outlook.ShowId">
                                    <a class="strong" href="shows/@outlook.ShowId">@outlook.Title</a>
                                    <FinishOutlookText Outlook="outlook" />
                                </li>
                            }
                        </ul>
                    }
                </Feature>

                @if (taste.Progress is { } progress && progress.Finished + progress.Watching + progress.Dropped > 0)
                {
                    <h3>Finished, watching, dropped</h3>
                    <div class="stat-tiles">
                        <div class="stat"><div class="stat-value">@progress.Finished</div><div class="muted">caught up</div></div>
                        <div class="stat"><div class="stat-value">@progress.Watching</div><div class="muted">watching</div></div>
                        <div class="stat"><div class="stat-value">@progress.Dropped</div><div class="muted">dropped (nothing for 30+ days)</div></div>
                    </div>
                    @if (progress.RecentlyDropped.Count > 0)
                    {
                        <p class="muted small">Pick one back up?</p>
                        <ul class="shared-cast">
                            @foreach (var show in progress.RecentlyDropped)
                            {
                                <li>
                                    <a href="shows/@show.ShowId">@show.Title</a>
                                    <span class="muted small">@show.Watched of @show.Aired episodes · last watched @Format.Relative(show.LastWatchedAtUtc)</span>
                                </li>
                            }
                        </ul>
                    }
                }
            </section>
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt />
    </NotAuthorized>
</AuthorizeView>

@code {
    private Stats? stats;
    private Taste? taste;
    private List<FinishOutlook>? finishing;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            stats = await Tracking.GetStatsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }

        try
        {
            taste = await Analytics.GetTasteAsync(Session.Profile?.TimeZone);
            finishing = await Analytics.GetFinishOutlooksAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            // Your taste is extra: the stats above work without Analytics.
        }
    }

    private static string BiasLabel(RatingBias bias) => bias.Label switch
    {
        "kinder" => "Generous rater",
        "harsher" => "Tough critic",
        _ => "In line with TVmaze"
    };

    private static string BiasText(RatingBias bias) => bias.Label switch
    {
        "in line" => $"Across {bias.Compared} ratings, your stars (doubled to TVmaze's 0-10) land close to TVmaze's.",
        _ => $"Across {bias.Compared} ratings, your stars (doubled to TVmaze's 0-10) are {Math.Abs(bias.AverageDifference):0.0} points " +
             $"{(bias.AverageDifference > 0 ? "above" : "below")} TVmaze's on average."
    };

    private static string MonthName(MonthWatch month) =>
        new DateTime(month.Year, month.Month, 1).ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
}
