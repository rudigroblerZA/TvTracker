@page "/"
@inject CatalogClient Catalog
@inject TrackingClient Tracking
@inject RecommendationsClient Recommendations
@inject UserSession Session
@inject IAuthActions Auth

<PageTitle>@Brand.AppName</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>@Brand.AppName</h1>
    </Authorized>
    <NotAuthorized>
        @* The landing page: what the app is, for someone who isn't signed in. Each claim is a feature that's on by
           default (FeatureFlags.OnByDefault, or not flagged): keep it in step when a flag's default changes. *@
        <section class="landing-hero">
            <h1>Know what to watch next, and whether it's worth it</h1>
            <p class="landing-lead">
                @Brand.AppName tracks every show you follow, tells you when the next episode airs, and reads the ratings of
                every episode so you know which are worth your time.
            </p>
            <div class="landing-actions">
                <button class="btn" @onclick="SignUpAsync">Get started free</button>
                <a class="btn btn-quiet" href="search">Browse shows</a>
            </div>
            <p class="muted small">New here? Choose <em>Register</em> on the sign-in page. Tracking is free, with no limit on shows or lists.</p>
        </section>

        <section class="landing-features" aria-label="What you get">
            <div class="landing-feature">
                <h2>Never lose your place</h2>
                <p>Up Next lines up the next episode of everything you're watching, the calendar shows what airs this week,
                    and the waiting room says when each show you're caught up on is back.</p>
            </div>
            <div class="landing-feature">
                <h2>Less to sit through</h2>
                <p>The essential cut of a long show, a plan for tonight that fits your time, a franchise's watch order, and a
                    spoiler shield for what you haven't seen.</p>
            </div>
            <div class="landing-feature">
                <h2>Bring your history</h2>
                <p>Import your TV Time or Trakt history with the date of every episode, so your stats start full.</p>
            </div>
            <div class="landing-feature">
                <h2>Watch with friends</h2>
                <p>Follow people, see what they're watching, and share lists by link. Your profile can be private.</p>
            </div>
        </section>

        <Feature Flag="@FeatureFlags.Plans">
        <section class="landing-plans">
            <h2>Free, with Plus when you want more</h2>
            <p>Following, tracking, ratings, lists, calendars and the insights about shows are free. <strong>Plus</strong>
                adds the tools that read your own viewing: tonight's plan, the essential cut of a long show, catching up
                before a premiere, your year in TV and more. <strong>Family</strong> shares Plus with up to five people.</p>
        </section>
        </Feature>
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <section>
            <div class="section-head">
                <h2>Up next</h2>
                <span>
                    <Feature Flag="@FeatureFlags.TonightPlan">
                        <a href="tonight">Plan tonight</a>
                        <span class="muted"> · </span>
                    </Feature>
                    <a href="up-next">See all</a>
                </span>
            </div>
            @if (upNext is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (upNext.Count == 0)
            {
                <p class="muted">Nothing to watch yet. <a href="search">Find a show</a> and follow it.</p>
            }
            else
            {
                <div class="card-row">
                    @foreach (var item in upNext.Take(6))
                    {
                        <ShowCard ShowId="item.ShowId" Title="@item.ShowTitle" PosterUrl="@item.PosterUrl"
                                  Subtitle="@($"{Format.EpisodeCode(item.Episode.SeasonNumber, item.Episode.EpisodeNumber)} · {item.Episode.Title}")">
                            @if (!item.HasAired && item.Episode.AirsAtUtc is { } airs)
                            {
                                <div class="tag">@Format.Relative(airs)</div>
                            }
                            else if (item.RemainingAired > 1)
                            {
                                <div class="tag">@item.RemainingAired to watch</div>
                            }
                        </ShowCard>
                    }
                </div>
            }
        </section>

        @if (forYou is { Count: > 0 })
        {
            <section>
                <div class="section-head">
                    <h2>For you</h2>
                    <a href="for-you">See all</a>
                </div>
                <div class="card-row">
                    @foreach (var show in forYou.Take(6))
                    {
                        <ShowCard ShowId="show.ShowId" Title="@show.Title" PosterUrl="@show.PosterUrl" Subtitle="@show.Reason" />
                    }
                </div>
            </section>
        }

        <Feature Flag="@FeatureFlags.HolidayEpisodes"><HolidayTeaser /></Feature>
        <Feature Flag="@FeatureFlags.TimeMachine"><TimeMachineTeaser /></Feature>
    </Authorized>
</AuthorizeView>

<section>
    <div class="section-head">
        <h2>Trending</h2>
        <a href="search">Browse</a>
    </div>
    <ErrorNotice Message="@error" OnRetry="LoadAsync" />
    @if (trending is not null)
    {
        <div class="card-grid">
            @foreach (var show in trending)
            {
                <ShowCard ShowId="show.Id" Title="@show.Title" PosterUrl="@show.PosterUrl"
                          Subtitle="@(string.Join(" · ", show.Genres.Take(2).Append(Format.Status(show.Status))))" />
            }
        </div>
    }
</section>

@code {
    private Task SignUpAsync() => Auth.SignInAsync();

    private List<ShowSummary>? trending;
    private List<UpNextItem>? upNext;
    private List<RecommendedShow>? forYou;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            trending = await Catalog.GetTrendingAsync() ?? [];

            await Session.EnsureLoadedAsync();
            if (Session.IsSignedIn)
            {
                upNext = await Tracking.GetUpNextAsync() ?? [];
                forYou = await Recommendations.GetForYouAsync(6) ?? [];
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
