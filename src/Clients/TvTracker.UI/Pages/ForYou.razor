@page "/for-you"
@inject RecommendationsClient Recommendations

<PageTitle>For you · @Brand.AppName</PageTitle>

<h1>For you</h1>

<AuthorizeView>
    <Authorized>
        <p class="muted">Picks based on what you follow, watch and rate. Updated as you go.</p>
        @* The page's three tools, pinned as on Discover, Insights and Up Next. There are no others, so nothing at the foot. *@
        <div class="feature-cards">
            <Feature Flag="@FeatureFlags.ReunionRadar" ShowLocked>
                <FeatureCard Href="reunions" Title="Reunion radar" Tone="mix-3">Where actors from shows you love work together again.</FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.MakersForYou" ShowLocked>
                <FeatureCard Href="makers" Title="From the makers you love" Tone="mix-1">What the creators of your favourites made next, and before.</FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.TasteTwins" ShowLocked>
                <FeatureCard Href="taste-twins" Title="Taste twins" Tone="mix-2">What people who rate like you loved, that you haven't seen.</FeatureCard>
            </Feature>
        </div>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        @if (picks is null)
        {
            @if (error is null)
            {
                <p class="muted">Loading…</p>
            }
        }
        else if (picks.Count == 0)
        {
            <p class="muted">Follow or rate a few shows and recommendations will appear here.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var pick in picks)
                {
                    <div class="card-with-action">
                        <ShowCard ShowId="pick.ShowId" Title="@pick.Title" PosterUrl="@pick.PosterUrl" Subtitle="@pick.Reason" />
                        <button class="link small" @onclick="() => DismissAsync(pick.ShowId)">Not interested</button>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to get recommendations based on what you watch." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<RecommendedShow>? picks;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            picks = await Recommendations.GetForYouAsync(24) ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private async Task DismissAsync(Guid showId)
    {
        // Gone at once, and back where it was if the dismissal didn't get through: it would return on the next load anyway.
        if (picks is null || picks.FindIndex(p => p.ShowId == showId) is not (>= 0 and var at))
        {
            return;
        }
        var pick = picks[at];
        picks.RemoveAt(at);
        error = null;
        try
        {
            await Recommendations.DismissAsync(showId);
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            picks.Insert(Math.Min(at, picks.Count), pick);
            error = ErrorNotice.Describe(ex);
        }
    }
}
