@page "/for-you"
@inject RecommendationsClient Recommendations

<PageTitle>For you · @Brand.AppName</PageTitle>

<h1>For you</h1>

<AuthorizeView>
    <Authorized>
        <p class="muted">Picks based on what you follow, watch and rate. Updated as you go.</p>
        @* The page's three tools, pinned as on Discover, Insights and Up Next. There are no others, so nothing at the foot. *@
        <div class="feature-cards">
            <Feature Flag="@FeatureFlags.ReunionRadar" ShowLocked>
                <FeatureCard Href="reunions" Title="Reunion radar" Tone="mix-3">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <circle cx="72" cy="40" r="34" fill="currentColor" opacity="0.12" />
                            <circle cx="72" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
                            <circle cx="72" cy="40" r="22" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
                            <circle cx="72" cy="40" r="10" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
                            <path d="M72 40 98 18A34 34 0 0 1 106 40z" fill="currentColor" opacity="0.3" />
                            <path d="M72 40 98 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M56 28 86 54" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 4" stroke-linecap="round" />
                            <circle cx="56" cy="28" r="5" fill="currentColor" />
                            <circle cx="86" cy="54" r="5" fill="currentColor" />
                            <circle cx="72" cy="40" r="2.5" fill="currentColor" />
                        </svg>
                    </Art>
                    <ChildContent>Where actors from shows you love work together again.</ChildContent>
                </FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.MakersForYou" ShowLocked>
                <FeatureCard Href="makers" Title="From the makers" Tone="mix-1">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <rect x="44" y="30" width="66" height="42" rx="6" fill="currentColor" opacity="0.2" />
                            <rect x="44" y="30" width="66" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M44 30 106 12l2 9-62 18z" fill="currentColor" opacity="0.35" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <path d="M58 26l4 9M72 22l4 9M86 18l4 9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                            <path d="M54 46h32M54 56h22" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.6" />
                        </svg>
                    </Art>
                    <ChildContent>What the creators of your favourites made next, and before.</ChildContent>
                </FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.TasteTwins" ShowLocked>
                <FeatureCard Href="taste-twins" Title="Taste twins" Tone="mix-2">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <circle cx="56" cy="26" r="13" fill="currentColor" opacity="0.3" />
                            <circle cx="56" cy="26" r="13" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M34 72c0-14 10-22 22-22s22 8 22 22z" fill="currentColor" opacity="0.3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <circle cx="88" cy="26" r="13" fill="var(--surface)" />
                            <circle cx="88" cy="26" r="13" fill="currentColor" opacity="0.55" />
                            <circle cx="88" cy="26" r="13" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M66 72c0-14 10-22 22-22s22 8 22 22z" fill="var(--surface)" />
                            <path d="M66 72c0-14 10-22 22-22s22 8 22 22z" fill="currentColor" opacity="0.55" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <path d="M16 20l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.1 5.9-.8z" fill="currentColor" />
                            <path d="M22 46l1.8 3.8 4.2.6-3 2.9.7 4.1-3.7-2-3.7 2 .7-4.1-3-2.9 4.2-.6z" fill="currentColor" opacity="0.6" />
                        </svg>
                    </Art>
                    <ChildContent>What people who rate like you loved, that you haven't seen.</ChildContent>
                </FeatureCard>
            </Feature>
        </div>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        @if (picks is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (picks.Count == 0)
        {
            <p class="muted">Follow or rate a few shows and recommendations will appear here.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var pick in picks)
                {
                    <div class="card-with-action">
                        <ShowCard ShowId="pick.ShowId" Title="@pick.Title" PosterUrl="@pick.PosterUrl" Subtitle="@pick.Reason" />
                        <button class="link small" @onclick="() => DismissAsync(pick.ShowId)">Not interested</button>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to get recommendations based on what you watch." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<RecommendedShow>? picks;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            picks = await Recommendations.GetForYouAsync(24) ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private async Task DismissAsync(Guid showId)
    {
        picks?.RemoveAll(p => p.ShowId == showId);
        try
        {
            await Recommendations.DismissAsync(showId);
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
