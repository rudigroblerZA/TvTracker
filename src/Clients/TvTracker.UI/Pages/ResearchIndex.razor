@page "/research"
@attribute [RequiresFeature(FeatureFlags.Research)]
@inject ResearchClient Research

<PageTitle>Research · @Brand.AppName</PageTitle>

<p><a href="settings">← Settings</a></p>
<h1>Research</h1>

<AuthorizeView>
    <Authorized>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />
        @if (shows is null)
        {
            @if (error is null)
            {
                <p class="muted">@(notModerator ? "Only moderators can research shows." : "Loading…")</p>
            }
        }
        else
        {
            @if (queue is not null)
            {
                <Feature Flag="@FeatureFlags.ResearchAssistant">
                    <section aria-labelledby="assistant-title">
                        <div class="section-head">
                            <h2 id="assistant-title">Research assistant</h2>
                            <button type="button" class="btn" disabled="@assistantStarted" @onclick="RunAssistantAsync">@(assistantStarted ? "Started" : "Run now")</button>
                        </div>
                        <p class="muted small">
                            A few times a day it gathers sources and drafts the insight for the top of this queue: research due a
                            refresh, then popular shows with none. It never saves, and it leaves alone any show someone is working on.
                            Shows it prepared are marked "prepared"; drafts take a few minutes each.
                        </p>
                    </section>
                </Feature>

                @if (queue.Refresh is { Count: > 0 } refresh)
                {
                    <section aria-labelledby="refresh-title">
                        <h2 id="refresh-title">Due a refresh</h2>
                        <p class="muted small">Saved research that may be out of date: a new season since it was saved, Wikidata disagreeing with the catalog, or over a year old.</p>
                        <ul class="research-list">
                            @foreach (var show in refresh)
                            {
                                <li @key="show.ShowId">
                                    <a href="research/@show.ShowId"><strong>@show.Title</strong></a>
                                    <span class="muted small">@($" · #{show.Rank} · version {show.Version}, saved {Format.Relative(show.SavedAtUtc)} · {string.Join(", ", show.Reasons.Select(ReasonLabel))}{(show.Prepared ? " · prepared" : "")}")</span>
                                </li>
                            }
                        </ul>
                    </section>
                }

                <section aria-labelledby="disagree-title">
                    <h2 id="disagree-title">Wikidata disagrees</h2>
                    <p class="muted small">
                        Popular shows where Wikidata's network, premiere date or (for ended shows) episode count differs from the
                        catalog's@(queue.CheckedAtUtc is { } at ? $", checked {Format.Relative(at)}" : ", not checked yet").
                        Saving research with the right value overrides the catalog's, and the show drops off after the next check.
                    </p>
                    @if (queue.Disagreements.Count == 0)
                    {
                        <p class="muted small">Nothing to look at.</p>
                    }
                    <ul class="research-list research-queue">
                        @foreach (var show in queue.Disagreements)
                        {
                            <li @key="show.ShowId">
                                <div>
                                    <a href="research/@show.ShowId"><strong>@show.Title</strong></a>
                                    <span class="muted small">@($" · #{show.Rank} most popular{(show.Researched ? " · researched" : "")} · ")</span><a class="small" href="@show.WikidataUrl" target="_blank" rel="noopener noreferrer">Wikidata</a>
                                </div>
                                <ul class="small">
                                    @foreach (var field in show.Fields)
                                    {
                                        <li>@($"{FieldLabel(field.Field)}: catalog {field.Catalog ?? "none"}, Wikidata {field.Wikidata}")</li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                </section>

                <section aria-labelledby="unresearched-title">
                    <h2 id="unresearched-title">Popular, not researched yet</h2>
                    <ul class="research-list">
                        @foreach (var show in queue.Unresearched)
                        {
                            <li @key="show.ShowId">
                                <a href="research/@show.ShowId"><strong>@show.Title</strong></a>
                                <span class="muted small">@($" · #{show.Rank}{(show.Network is { } n ? $" · {n}" : "")}{(show.Year is { } y ? $" · {y}" : "")}{(show.Prepared ? " · prepared" : show.Started ? " · started" : "")}")</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            <h2>In progress and saved</h2>
            <p class="muted">Shows being researched, most recently worked on first. To start one, open the show and choose "Research this show".</p>
            @if (shows.Count == 0)
            {
                <p class="muted">None yet.</p>
            }
            <ul class="research-list">
                @foreach (var show in shows)
                {
                    <li @key="show.ShowId">
                        <a href="research/@show.ShowId"><strong>@show.Title</strong></a>
                        <span class="muted small">@(show.Version is { } v ? $" · version {v}, saved {Format.Relative(show.SavedAtUtc!.Value)}" : " · not saved yet")</span>
                    </li>
                }
            </ul>
        }
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in as a moderator to research shows." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ResearchedShow>? shows;
    private ResearchQueue? queue;

    private static string FieldLabel(string field) => field switch
    {
        "network" => "Network",
        "premiered" => "Premiere",
        "episodes" => "Episodes",
        _ => field
    };
    private bool notModerator;
    private string? error;
    private bool assistantStarted;

    private static string ReasonLabel(string reason) => reason switch
    {
        "new-season" => "new season",
        "wikidata" => "Wikidata disagrees",
        "old" => "over a year old",
        _ => reason
    };

    private async Task RunAssistantAsync()
    {
        try
        {
            await Research.RunAssistantAsync();
            assistantStarted = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            shows = await Research.GetResearchedAsync();
            notModerator = shows is null;
            if (shows is not null)
            {
                queue = await Research.GetQueueAsync();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
