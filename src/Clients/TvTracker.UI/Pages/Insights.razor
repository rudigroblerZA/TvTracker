@page "/insights"
@inject AnalyticsClient Analytics
@inject FeatureFlagStore Flags
@inject CatalogClient Catalog

<PageTitle>Insights · @Brand.AppName</PageTitle>

<h1>Insights</h1>

<AuthorizeView>
    <Authorized>
        @* Three pinned, as on Discover: the rest of the tools are at the foot of the page. *@
        <div class="feature-cards">
            <Feature Flag="@FeatureFlags.CallIt" ShowLocked>
                <FeatureCard Href="calls" Title="Call it" Tone="mix-0">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <path d="M8 70h104" stroke="currentColor" stroke-width="1.5" opacity="0.35" />
                            <path d="M10 56 30 44 50 50 70 30" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M70 30 98 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 7" />
                            <circle cx="10" cy="56" r="3.5" fill="currentColor" />
                            <circle cx="30" cy="44" r="3.5" fill="currentColor" />
                            <circle cx="50" cy="50" r="3.5" fill="currentColor" />
                            <circle cx="70" cy="30" r="3.5" fill="currentColor" />
                            <circle cx="98" cy="16" r="10" fill="currentColor" opacity="0.2" />
                            <circle cx="98" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <circle cx="98" cy="16" r="3.5" fill="currentColor" />
                        </svg>
                    </Art>
                    <ChildContent>Predict your shows' next seasons before they air, and see if you beat the forecast.</ChildContent>
                </FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.Streaks" ShowLocked>
                <FeatureCard Href="streaks" Title="Streaks" Tone="mix-1">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <g fill="currentColor">
                                <rect x="6" y="12" width="14" height="14" rx="4" opacity="0.2" />
                                <rect x="24" y="12" width="14" height="14" rx="4" opacity="0.2" />
                                <rect x="42" y="12" width="14" height="14" rx="4" opacity="0.5" />
                                <rect x="60" y="12" width="14" height="14" rx="4" opacity="0.2" />
                                <rect x="78" y="12" width="14" height="14" rx="4" opacity="0.2" />
                                <rect x="96" y="12" width="14" height="14" rx="4" opacity="0.5" />
                                <rect x="6" y="33" width="14" height="14" rx="4" opacity="0.5" />
                                <rect x="24" y="33" width="14" height="14" rx="4" opacity="0.2" />
                                <rect x="42" y="33" width="14" height="14" rx="4" />
                                <rect x="60" y="33" width="14" height="14" rx="4" />
                                <rect x="78" y="33" width="14" height="14" rx="4" />
                                <rect x="96" y="33" width="14" height="14" rx="4" />
                                <rect x="6" y="54" width="14" height="14" rx="4" />
                                <rect x="24" y="54" width="14" height="14" rx="4" />
                                <rect x="42" y="54" width="14" height="14" rx="4" />
                                <rect x="60" y="54" width="14" height="14" rx="4" opacity="0.2" />
                            </g>
                        </svg>
                    </Art>
                    <ChildContent>Days in a row, and the shows you keep up with as they air.</ChildContent>
                </FeatureCard>
            </Feature>
            <Feature Flag="@FeatureFlags.HolidayEpisodes" ShowLocked>
                <FeatureCard Href="holidays" Title="Holiday episodes" Tone="mix-2">
                    <Art>
                        <svg viewBox="0 0 120 80">
                            <path d="M78 6 62 30h8L54 52h10L48 72h60L92 52h10L86 30h8z" fill="currentColor" opacity="0.3" />
                            <path d="M78 6 62 30h8L54 52h10L48 72h60L92 52h10L86 30h8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <circle cx="72" cy="40" r="3" fill="currentColor" />
                            <circle cx="86" cy="46" r="3" fill="currentColor" />
                            <circle cx="66" cy="62" r="3" fill="currentColor" />
                            <circle cx="82" cy="60" r="3" fill="currentColor" />
                            <circle cx="96" cy="64" r="3" fill="currentColor" />
                            <path d="M22 40c-9 0-14 6-14 14s5 14 14 14 14-6 14-14-5-14-14-14zM22 40v-7" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M22 41c-4 3-4 23 0 26M22 41c4 3 4 23 0 26" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6" />
                        </svg>
                    </Art>
                    <ChildContent>Your shows' Halloween, Christmas and other holiday episodes.</ChildContent>
                </FeatureCard>
            </Feature>
        </div>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        @if (verdicts is { Count: > 0 })
        {
            <Feature Flag="@FeatureFlags.SeasonVerdict">
                <section aria-labelledby="verdicts-title">
                    <h2 id="verdicts-title">Seasons that just ended</h2>
                    <p class="muted small">How each did against the show's other seasons, a few days after its finale.</p>
                    <ul class="backlog-list season-verdicts">
                        @foreach (var item in verdicts)
                        {
                            <li class="tone-@SeasonVerdictText.Tone(item.Verdict)" @key="item.ShowId">
                                <a href="shows/@item.ShowId"><strong>@item.Title</strong></a>
                                <span class="muted">@($" · season {item.Verdict.Number}, ended {Format.Relative(item.Verdict.FinaleAiredAtUtc)}")</span>
                                <div><strong>@SeasonVerdictText.Headline(item.Verdict)</strong><span class="muted small">@($" · {SeasonVerdictText.Details(item.Verdict)}")</span></div>
                            </li>
                        }
                    </ul>
                </section>
            </Feature>
        }

        <section>
            <div class="section-header">
                <h2>Premieres coming up</h2>
                <select @bind="premiereSort" @bind:after="LoadPremieresAsync" aria-label="Sort premieres">
                    <option value="date">Soonest first</option>
                    <option value="rating">Highest rated first</option>
                    <option value="anticipated">Most anticipated</option>
                </select>
            </div>
            @if (premieres is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (premieres.Count == 0)
            {
                <p class="muted">No season premieres in the next 60 days.</p>
            }
            else
            {
                <ul class="premieres">
                    @foreach (var p in premieres)
                    {
                        <li class="panel">
                            <Poster Title="@p.ShowTitle" Url="@p.PosterUrl" Size="small" />
                            <div>
                                <a href="shows/@p.ShowId"><strong>@p.ShowTitle</strong></a>
                                <span class="muted">season @p.SeasonNumber</span>
                                @if (p.ShowExternalRating is { } rating)
                                {
                                    <span class="tag">@Format.Rating(rating)</span>
                                }
                                <div>@Format.Relative(p.PremieresAtUtc) · <LocalTime Utc="p.PremieresAtUtc" /></div>
                                @if (p.CatchUpEpisodes > 0)
                                {
                                    <div class="muted small">Catch up: @p.CatchUpEpisodes episodes, @Format.Duration(p.CatchUpRuntimeMinutes)</div>
                                }
                                @if (p.RecentFollows is > 0)
                                {
                                    <div class="muted small">@p.RecentFollows new followers in the last 4 weeks</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section>
            <div class="section-header">
                <h2>Top episodes</h2>
                <select @bind="genre" @bind:after="LoadTopEpisodesAsync" aria-label="Genre">
                    <option value="">All genres</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            @if (topEpisodes is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (topEpisodes.Count == 0)
            {
                <p class="muted">No rated episodes yet.</p>
            }
            else
            {
                <ol class="top-episodes">
                    @foreach (var e in topEpisodes)
                    {
                        <li>
                            <a href="shows/@e.ShowId">@e.ShowTitle</a>
                            <span class="code">@Format.EpisodeCode(e.SeasonNumber, e.EpisodeNumber)</span>
                            <a href="episodes/@e.EpisodeId">@e.Title</a>
                            <span class="muted small">
                                @if (e.Rating.External is { } r) { <text>@Format.Rating(r)</text> }
                                @if (e.Rating.Ours is { } o) { <text> · @Format.Stars(o, e.Rating.OurCount)</text> }
                            </span>
                        </li>
                    }
                </ol>
            }
        </section>

        <p>
            <a href="discover"><strong>Discover</strong></a><span class="muted">: hidden gems, bingeable shows, fan favorites, best finales and more.</span>
        </p>

        <p class="muted small">Ratings from <a href="https://www.tvmaze.com" target="_blank" rel="noopener">TVmaze</a> and @Brand.AppName users. Updated hourly.</p>

        <section class="more-tools">
            <h2>More insights</h2>
            <div class="tool-links">
                <Feature Flag="@FeatureFlags.TvClock" ShowLocked>
                    <ToolLink Href="tv-clock" Title="Your TV clock">When you watch, what kind of viewer that makes you, and your longest sitting.</ToolLink>
                </Feature>
                <Feature Flag="@FeatureFlags.TvLife" ShowLocked>
                    <ToolLink Href="tv-life" Title="Your TV life">Every year of your life: what premiered, what ended, and what you watched.</ToolLink>
                </Feature>
                <Feature Flag="@FeatureFlags.TimeMachine" ShowLocked>
                    <ToolLink Href="time-machine" Title="TV time machine">What premiered, ended and stood out this week in TV history.</ToolLink>
                </Feature>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to see insights: upcoming premieres, top episodes and more." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<SeasonVerdictItem>? verdicts;
    private List<PremiereItem>? premieres;
    private List<TopEpisodeItem>? topEpisodes;
    private List<string> genres = [];
    private string premiereSort = "date";
    private string genre = "";
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            genres = await Catalog.GetGenresAsync() ?? [];
        }
        catch (HttpRequestException)
        {
            // The genre filter is optional.
        }
        await Task.WhenAll(LoadVerdictsAsync(), LoadPremieresAsync(), LoadTopEpisodesAsync());
    }

    /// <summary>
    /// Optional: not asked for while the season-verdict flag is off, and hidden when the call fails.
    /// </summary>
    private async Task LoadVerdictsAsync()
    {
        try
        {
            verdicts = await Flags.IfEnabledAsync(FeatureFlags.SeasonVerdict, () => Analytics.GetSeasonVerdictsAsync());
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            // The premieres and top episodes say so if the session has ended.
            verdicts = null;
        }
    }

    private Task LoadPremieresAsync() => RunAsync(async () => premieres = await Analytics.GetPremieresAsync(60, premiereSort) ?? []);

    private Task LoadTopEpisodesAsync() => RunAsync(async () => topEpisodes = await Analytics.GetTopEpisodesAsync(genre, 20) ?? []);

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
