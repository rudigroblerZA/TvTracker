@page "/insights"
@inject AnalyticsClient Analytics
@inject CatalogClient Catalog

<PageTitle>Insights · TV Tracker</PageTitle>

<h1>Insights</h1>

<AuthorizeView>
    <Authorized>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        <section>
            <div class="section-header">
                <h2>Premieres coming up</h2>
                <select @bind="premiereSort" @bind:after="LoadPremieresAsync" aria-label="Sort premieres">
                    <option value="date">Soonest first</option>
                    <option value="rating">Highest rated first</option>
                    <option value="anticipated">Most anticipated</option>
                </select>
            </div>
            @if (premieres is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (premieres.Count == 0)
            {
                <p class="muted">No season premieres in the next 60 days.</p>
            }
            else
            {
                <ul class="premieres">
                    @foreach (var p in premieres)
                    {
                        <li class="panel">
                            <Poster Title="@p.ShowTitle" Url="@p.PosterUrl" Size="small" />
                            <div>
                                <a href="shows/@p.ShowId"><strong>@p.ShowTitle</strong></a>
                                <span class="muted">season @p.SeasonNumber</span>
                                @if (p.ShowExternalRating is { } rating)
                                {
                                    <span class="tag">@Format.Rating(rating)</span>
                                }
                                <div>@Format.Relative(p.PremieresAtUtc) · <LocalTime Utc="p.PremieresAtUtc" /></div>
                                @if (p.CatchUpEpisodes > 0)
                                {
                                    <div class="muted small">Catch up: @p.CatchUpEpisodes episodes, @Format.Duration(p.CatchUpRuntimeMinutes)</div>
                                }
                                @if (p.RecentFollows is > 0)
                                {
                                    <div class="muted small">@p.RecentFollows new followers in the last 4 weeks</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section>
            <div class="section-header">
                <h2>Top episodes</h2>
                <select @bind="genre" @bind:after="LoadTopEpisodesAsync" aria-label="Genre">
                    <option value="">All genres</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            @if (topEpisodes is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (topEpisodes.Count == 0)
            {
                <p class="muted">No rated episodes yet.</p>
            }
            else
            {
                <ol class="top-episodes">
                    @foreach (var e in topEpisodes)
                    {
                        <li>
                            <a href="shows/@e.ShowId">@e.ShowTitle</a>
                            <span class="code">@Format.EpisodeCode(e.SeasonNumber, e.EpisodeNumber)</span>
                            <a href="episodes/@e.EpisodeId">@e.Title</a>
                            <span class="muted small">
                                @if (e.Rating.External is { } r) { <text>@Format.Rating(r)</text> }
                                @if (e.Rating.Ours is { } o) { <text> · @Format.Stars(o, e.Rating.OurCount)</text> }
                            </span>
                        </li>
                    }
                </ol>
            }
        </section>

        <section>
            <div class="section-header">
                <h2>Discover</h2>
                <select @bind="discoverGenre" @bind:after="LoadDiscoveryAsync" aria-label="Genre for discovery lists">
                    <option value="">All genres</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="tabs" role="tablist">
                @foreach (var (key, label, _) in DiscoveryTabs)
                {
                    <button role="tab" aria-selected="@(key == discoverList)" class="@(key == discoverList ? "active" : "")"
                            @onclick="() => SelectDiscoveryAsync(key)">@label</button>
                }
            </div>
            <p class="muted small">@DiscoveryTabs.First(t => t.Key == discoverList).Description</p>
            @if (discovery is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (discovery.Count == 0)
            {
                <p class="muted">Nothing here yet@(string.IsNullOrEmpty(discoverGenre) ? "" : $" for {discoverGenre}").</p>
            }
            else
            {
                <ol class="discovery">
                    @foreach (var item in discovery)
                    {
                        <li>
                            <Poster Title="@item.ShowTitle" Url="@item.PosterUrl" Size="small" />
                            <div>
                                <a href="shows/@item.ShowId"><strong>@item.ShowTitle</strong></a>
                                @if (item.EpisodeId is { } episodeId)
                                {
                                    <div>
                                        <span class="code">@Format.EpisodeCode(item.SeasonNumber ?? 0, item.EpisodeNumber ?? 0)</span>
                                        <a href="episodes/@episodeId">@item.EpisodeTitle</a>
                                    </div>
                                }
                                <div class="muted small">@DiscoveryDetail(item)</div>
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>

        <p class="muted small">Ratings from <a href="https://www.tvmaze.com" target="_blank" rel="noopener">TVmaze</a> and TV Tracker users. Updated hourly.</p>
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to see insights: upcoming premieres, top episodes and more." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<PremiereItem>? premieres;
    private List<TopEpisodeItem>? topEpisodes;
    private List<string> genres = [];
    private string premiereSort = "date";
    private string genre = "";
    private string? error;
    private List<DiscoveryItem>? discovery;
    private string discoverList = "hidden-gems";
    private string discoverGenre = "";

    private static readonly (string Key, string Label, string Description)[] DiscoveryTabs =
    [
        ("hidden-gems", "Hidden gems", "Highly rated shows that fly under the radar: less well known, and few TV Tracker users follow them yet."),
        ("most-consistent", "Most consistent", "Well-rated shows whose episodes hardly ever dip."),
        ("rollercoasters", "Rollercoasters", "Well-rated shows with the biggest swings between episodes."),
        ("best-finales", "Best finales", "Season finales that stand out most from their show's usual episodes."),
        ("bingeable", "Bingeable", "Short seasons, around 8 episodes, under 50 hours in all, with nothing left to wait for."),
        ("weekend-binges", "Weekend binges", "Everything aired fits in 12 hours or less."),
        ("fan-favorites", "Fan favorites", "Loved by TV Tracker users (4.3★ or more), or by TVmaze's viewers (8.5 or more).")
    ];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            genres = await Catalog.GetGenresAsync() ?? [];
        }
        catch (HttpRequestException)
        {
            // The genre filter is optional.
        }
        await LoadPremieresAsync();
        await LoadTopEpisodesAsync();
        await LoadDiscoveryAsync();
    }

    private Task SelectDiscoveryAsync(string list)
    {
        discoverList = list;
        return LoadDiscoveryAsync();
    }

    private Task LoadDiscoveryAsync() => RunAsync(async () =>
    {
        discovery = null;
        discovery = await Analytics.GetDiscoveryAsync(discoverList, discoverGenre, 15) ?? [];
    });

    private string DiscoveryDetail(DiscoveryItem item)
    {
        var rating = item.ShowExternalRating is { } r ? $"Show rated {Format.Rating(r)}" : null;
        var detail = discoverList switch
        {
            "most-consistent" or "rollercoasters" => $"Episode spread {item.Value:0.00}",
            "best-finales" => $"Finale rated {Format.Rating(item.Value)}",
            "bingeable" or "weekend-binges" => $"{Format.Duration((int)item.Value)} to watch it all",
            "fan-favorites" when item.Value > 0 => $"★ {item.Value:0.0} from TV Tracker users",
            _ => null
        };
        return string.Join(" · ", new[] { rating, detail }.Where(s => s is not null));
    }

    private Task LoadPremieresAsync() => RunAsync(async () => premieres = await Analytics.GetPremieresAsync(60, premiereSort) ?? []);

    private Task LoadTopEpisodesAsync() => RunAsync(async () => topEpisodes = await Analytics.GetTopEpisodesAsync(genre, 20) ?? []);

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
