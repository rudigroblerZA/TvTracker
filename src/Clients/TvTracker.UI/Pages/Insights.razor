@page "/insights"
@inject AnalyticsClient Analytics
@inject CatalogClient Catalog

<PageTitle>Insights · @Brand.AppName</PageTitle>

<h1>Insights</h1>

<AuthorizeView>
    <Authorized>
        <Feature Flag="@FeatureFlags.Ask">
            <p><a href="ask"><strong>Ask</strong></a><span class="muted">: ask about any show, person or list ("hidden gems in drama", "does Breaking Bad stick the landing?"), answered from these insights.</span></p>
        </Feature>
        <Feature Flag="@FeatureFlags.TimeMachine">
            <p><a href="time-machine"><strong>TV time machine</strong></a><span class="muted">: what premiered, ended and stood out this week in TV history, or the week of any date.</span></p>
        </Feature>
        <Feature Flag="@FeatureFlags.HolidayEpisodes">
            <p><a href="holidays"><strong>Holiday episodes</strong></a><span class="muted">: the Halloween, Thanksgiving, Christmas, New Year's and Valentine's episodes of your shows, and where each sits against how far you are.</span></p>
        </Feature>
        <ErrorNotice Message="@error" OnRetry="LoadAsync" />

        @if (verdicts is { Count: > 0 })
        {
            <Feature Flag="@FeatureFlags.SeasonVerdict">
                <section aria-labelledby="verdicts-title">
                    <h2 id="verdicts-title">Seasons that just ended</h2>
                    <p class="muted small">How each did against the show's other seasons, a few days after its finale.</p>
                    <ul class="season-verdicts">
                        @foreach (var item in verdicts)
                        {
                            <li class="season-verdict tone-@SeasonVerdictText.Tone(item.Verdict)" @key="item.ShowId">
                                <a href="shows/@item.ShowId"><strong>@item.Title</strong></a>
                                <span class="muted">@($" · season {item.Verdict.Number}, ended {Format.Relative(item.Verdict.FinaleAiredAtUtc)}")</span>
                                <div><strong>@SeasonVerdictText.Headline(item.Verdict)</strong><span class="muted small">@($" · {SeasonVerdictText.Details(item.Verdict)}")</span></div>
                            </li>
                        }
                    </ul>
                </section>
            </Feature>
        }

        <section>
            <div class="section-header">
                <h2>Premieres coming up</h2>
                <select @bind="premiereSort" @bind:after="LoadPremieresAsync" aria-label="Sort premieres">
                    <option value="date">Soonest first</option>
                    <option value="rating">Highest rated first</option>
                    <option value="anticipated">Most anticipated</option>
                </select>
            </div>
            @if (premieres is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (premieres.Count == 0)
            {
                <p class="muted">No season premieres in the next 60 days.</p>
            }
            else
            {
                <ul class="premieres">
                    @foreach (var p in premieres)
                    {
                        <li class="panel">
                            <Poster Title="@p.ShowTitle" Url="@p.PosterUrl" Size="small" />
                            <div>
                                <a href="shows/@p.ShowId"><strong>@p.ShowTitle</strong></a>
                                <span class="muted">season @p.SeasonNumber</span>
                                @if (p.ShowExternalRating is { } rating)
                                {
                                    <span class="tag">@Format.Rating(rating)</span>
                                }
                                <div>@Format.Relative(p.PremieresAtUtc) · <LocalTime Utc="p.PremieresAtUtc" /></div>
                                @if (p.CatchUpEpisodes > 0)
                                {
                                    <div class="muted small">Catch up: @p.CatchUpEpisodes episodes, @Format.Duration(p.CatchUpRuntimeMinutes)</div>
                                }
                                @if (p.RecentFollows is > 0)
                                {
                                    <div class="muted small">@p.RecentFollows new followers in the last 4 weeks</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section>
            <div class="section-header">
                <h2>Top episodes</h2>
                <select @bind="genre" @bind:after="LoadTopEpisodesAsync" aria-label="Genre">
                    <option value="">All genres</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            @if (topEpisodes is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (topEpisodes.Count == 0)
            {
                <p class="muted">No rated episodes yet.</p>
            }
            else
            {
                <ol class="top-episodes">
                    @foreach (var e in topEpisodes)
                    {
                        <li>
                            <a href="shows/@e.ShowId">@e.ShowTitle</a>
                            <span class="code">@Format.EpisodeCode(e.SeasonNumber, e.EpisodeNumber)</span>
                            <a href="episodes/@e.EpisodeId">@e.Title</a>
                            <span class="muted small">
                                @if (e.Rating.External is { } r) { <text>@Format.Rating(r)</text> }
                                @if (e.Rating.Ours is { } o) { <text> · @Format.Stars(o, e.Rating.OurCount)</text> }
                            </span>
                        </li>
                    }
                </ol>
            }
        </section>

        <p>
            <a href="discover"><strong>Discover</strong></a><span class="muted">: hidden gems, bingeable shows, fan favorites, best finales and more.</span>
        </p>

        <p class="muted small">Ratings from <a href="https://www.tvmaze.com" target="_blank" rel="noopener">TVmaze</a> and @Brand.AppName users. Updated hourly.</p>
    </Authorized>
    <NotAuthorized>
        <SignInPrompt Message="Sign in to see insights: upcoming premieres, top episodes and more." />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<SeasonVerdictItem>? verdicts;
    private List<PremiereItem>? premieres;
    private List<TopEpisodeItem>? topEpisodes;
    private List<string> genres = [];
    private string premiereSort = "date";
    private string genre = "";
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            genres = await Catalog.GetGenresAsync() ?? [];
        }
        catch (HttpRequestException)
        {
            // The genre filter is optional.
        }
        await Task.WhenAll(LoadVerdictsAsync(), LoadPremieresAsync(), LoadTopEpisodesAsync());
    }

    /// <summary>Optional: hidden when the season-verdict flag is off (404) or the call fails.</summary>
    private async Task LoadVerdictsAsync()
    {
        try
        {
            verdicts = await Analytics.GetSeasonVerdictsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            // The premieres and top episodes say so if the session has ended.
            verdicts = null;
        }
    }

    private Task LoadPremieresAsync() => RunAsync(async () => premieres = await Analytics.GetPremieresAsync(60, premiereSort) ?? []);

    private Task LoadTopEpisodesAsync() => RunAsync(async () => topEpisodes = await Analytics.GetTopEpisodesAsync(genre, 20) ?? []);

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }
}
