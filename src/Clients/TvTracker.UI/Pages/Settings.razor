@page "/settings"
@inject IdentityClient Identity
@inject RatingsClient Ratings
@inject NotificationsClient Notifications
@inject UserSession Session
@inject IPlatformServices Platform
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IAuthActions Auth
@inject SpoilerShield Shield
@inject ThemeStore Theme
@implements IAsyncDisposable
@inject SocialClient Social

<PageTitle>Settings · @Brand.AppName</PageTitle>

<div class="settings-page">
<h1>Settings</h1>

@* Where the page's sections are, for a phone: the page is long, and this is its only way around. *@
<nav class="settings-jump" aria-label="Settings sections">
    <a href="settings#theme">Theme</a>
    <AuthorizeView>
        <Authorized>
            <a href="settings#profile">Profile</a>
            <a href="settings#notifications">Notifications</a>
            <Feature Flag="@FeatureFlags.Social"><a href="settings#social">Social</a></Feature>
            <Feature Flag="@FeatureFlags.SpoilerShield"><a href="settings#spoilers">Spoiler shield</a></Feature>
            <Feature Flag="@FeatureFlags.HistoryImport"><a href="settings#history">History</a></Feature>
            <Feature Flag="@FeatureFlags.Plans"><a href="settings#plan">Plan</a></Feature>
            @if (isAdmin || isModerator)
            {
                <a href="settings#admin">Admin</a>
            }
            <a href="settings#data">Your data</a>
        </Authorized>
    </AuthorizeView>
</nav>

<section id="theme" class="panel">
    <h2>Theme</h2>
    <div class="chips" role="radiogroup" aria-label="Theme">
        @foreach (var (value, label) in ThemeStore.Choices)
        {
            <button type="button" role="radio" aria-checked="@(theme == value ? "true" : "false")" class="chip @(theme == value ? "active" : "")" @onclick="() => SetThemeAsync(value)">@label</button>
        }
    </div>
    <p class="muted small">On this device or browser.</p>
</section>

<AuthorizeView>
    <Authorized>
        <ErrorNotice Message="@error" />
        @if (!string.IsNullOrEmpty(saved))
        {
            <div class="notice" role="status">@saved</div>
        }

        <section id="profile" class="panel">
            <h2>Profile</h2>
            @if (profile is null)
            {
                <p class="muted">Loading…</p>
            }
            else
            {
                <form class="stack" @onsubmit="SaveProfileAsync">
                    <label>Display name <input @bind="displayName" maxlength="100" required /></label>
                    <div class="avatar-edit">
                        <Avatar Name="@profile.DisplayName" Src="@profile.Avatar" Large />
                        <div class="stack">
                            <div class="avatar-actions">
                                @* The real file input is hidden; this label is its button. *@
                                <label class="btn btn-quiet small" aria-disabled="@uploading">
                                    @(uploading ? "Uploading…" : profile.AvatarUploaded ? "Change picture" : "Upload a picture")
                                    <input type="file" accept="image/jpeg,image/png,image/webp" @ref="avatarFile" @onchange="UploadAvatarAsync" disabled="@uploading" />
                                </label>
                                @if (profile.AvatarUploaded)
                                {
                                    <button type="button" class="btn btn-quiet small" @onclick="RemoveAvatarAsync" disabled="@uploading">Remove</button>
                                }
                            </div>
                            <span class="muted small">Shown beside your name on your profile, in people lists and in the feed. It's cropped to a square.</span>
                        </div>
                    </div>
                    <label>
                        Or a picture's address
                        <input @bind="avatarUrl" type="url" placeholder="https://…" maxlength="1024" />
                        <span class="muted small">Used when you haven't uploaded one. It's loaded from that site by everyone who sees it.</span>
                    </label>
                    <label>
                        Timezone
                        <span class="inline">
                            <input @bind="timeZone" placeholder="Africa/Johannesburg" />
                            <button type="button" class="btn btn-quiet small" @onclick="UseDeviceTimeZoneAsync">Use this device's</button>
                        </span>
                        <span class="muted small">Air times are shown in this timezone.</span>
                    </label>
                    <label>
                        Region
                        <input @bind="region" maxlength="2" placeholder="ZA" />
                        <span class="muted small">Two-letter country code; decides which streaming services are listed.</span>
                    </label>
                    <label>Language <input @bind="language" maxlength="10" placeholder="en" /></label>
                    <div><button class="btn" type="submit">Save profile</button></div>
                </form>
            }
        </section>

        <section id="notifications" class="panel">
            <h2>Notifications</h2>
            @if (prefs is null)
            {
                <p class="muted">Loading…</p>
            }
            else
            {
                <form class="stack" @onsubmit="SavePreferencesAsync">
                    <fieldset>
                        <legend>Tell me about</legend>
                        <label class="checkbox"><input type="checkbox" @bind="prefs.NewEpisodes" /> New episodes of shows I follow</label>
                        <label class="checkbox"><input type="checkbox" @bind="prefs.NewSeasons" /> New seasons</label>
                        <Feature Flag="@FeatureFlags.SeasonVerdict">
                            <label class="checkbox"><input type="checkbox" @bind="prefs.SeasonVerdicts" /> How a season did, once it ends</label>
                        </Feature>
                        <label class="checkbox"><input type="checkbox" @bind="prefs.StatusChanges" /> Renewals, cancellations and endings</label>
                    </fieldset>
                    <fieldset>
                        <legend>Send them by</legend>
                        <label class="checkbox"><input type="checkbox" @bind="prefs.PushEnabled" /> Phone notifications</label>
                        <label class="checkbox"><input type="checkbox" @bind="prefs.WebPushEnabled" /> Browser notifications</label>
                        <label class="checkbox"><input type="checkbox" @bind="prefs.EmailEnabled" /> Email @(string.IsNullOrEmpty(prefs.Email) ? "" : $"({prefs.Email})")</label>
                    </fieldset>
                    <Feature Flag="@FeatureFlags.WeeklyDigest">
                        <fieldset>
                            <legend>Weekly digest</legend>
                            <label class="checkbox"><input type="checkbox" @bind="prefs.WeeklyDigest" disabled="@string.IsNullOrEmpty(prefs.Email)" /> One email a week instead of an email per alert</label>
                            @if (string.IsNullOrEmpty(prefs.Email))
                            {
                                <span class="muted small">It needs an email address on your account.</span>
                            }
                            <span class="inline">
                                <label>On <select @bind="prefs.DigestDay">
                                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                                    {
                                        <option value="@day">@day</option>
                                    }
                                </select></label>
                                <label>from <select @bind="prefs.DigestHour">
                                    @for (var h = 0; h < 24; h++)
                                    {
                                        <option value="@h">@($"{h:00}:00")</option>
                                    }
                                </select></label>
                            </span>
                            <span class="muted small">What's coming up on your shows that week, and what you were told since the last one. Phone and browser alerts carry on as they are.</span>
                            <div><button type="button" class="btn btn-quiet small" @onclick="PreviewDigestAsync">Preview this week's digest</button></div>
                            @if (digest is not null)
                            {
                                <div class="digest-preview">
                                    <strong>@digest.Subject</strong>
                                    @if (digest.Sections.Count == 0)
                                    {
                                        <p class="muted small">Nothing this week, so nothing would be sent.</p>
                                    }
                                    @foreach (var part in digest.Sections)
                                    {
                                        <h3>@part.Heading</h3>
                                        <ul>
                                            @foreach (var line in part.Lines)
                                            {
                                                <li>@if (line.Link is { } link) { <a href="@link.TrimStart('/')">@line.Text</a> } else { <span>@line.Text</span> }</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        </fieldset>
                    </Feature>
                    <fieldset>
                        <legend>Quiet hours</legend>
                        <span class="inline">
                            <label>From <input type="time" @bind="prefs.QuietHoursStart" /></label>
                            <label>to <input type="time" @bind="prefs.QuietHoursEnd" /></label>
                        </span>
                        <span class="muted small">Notifications during quiet hours arrive when they end. Leave empty to turn off.</span>
                    </fieldset>
                    <div><button class="btn" type="submit">Save notification settings</button></div>
                </form>

                @if (Platform.SupportsPush)
                {
                    <div class="actions">
                        <button class="btn btn-quiet" @onclick="EnablePushAsync">Turn on notifications on this device</button>
                    </div>
                }

                @if (devices is { Count: > 0 })
                {
                    <h3>Devices receiving notifications</h3>
                    <ul class="devices">
                        @foreach (var device in devices)
                        {
                            <li>
                                @device.Platform · added @device.CreatedAtUtc.ToString("d MMM yyyy")
                                <button class="link small" @onclick="() => RemoveDeviceAsync(device.Id)">Remove</button>
                            </li>
                        }
                    </ul>
                }
            }
        </section>

        <Feature Flag="@FeatureFlags.Social">
            <section id="social" class="panel">
                <h2>Social</h2>
                <label class="checkbox">
                    <input type="checkbox" checked="@shareActivity" disabled="@(shareActivity is null)" @onchange="e => SetSocialAsync(e.Value is true, null)" />
                    Share what I watch, finish, follow and rate with people who follow me
                </label>
                <p class="muted small">Turned off, nobody sees your activity, including what's already in their feed.</p>
                <label class="checkbox">
                    <input type="checkbox" checked="@privateProfile" disabled="@(shareActivity is null)" @onchange="e => SetSocialAsync(null, e.Value is true)" />
                    Private profile: approve who follows me
                </label>
                <p class="muted small">Only people you approve see your activity, lists and followers; others see just your name. Requests are under Feed → People. Making it public again approves every request waiting.</p>
            </section>
        </Feature>

        <Feature Flag="@FeatureFlags.SpoilerShield">
            <section id="spoilers" class="panel">
                <h2>Spoiler shield</h2>
                <label class="checkbox">
                    <input type="checkbox" checked="@spoilerShield" @onchange="e => SetSpoilerShieldAsync(e.Value is true)" />
                    Hide titles and summaries of episodes I haven't watched
                </label>
                <p class="muted small">On this device or browser. A hidden title shows when you select it.</p>
            </section>
        </Feature>

        <Feature Flag="@FeatureFlags.HistoryImport">
            <section id="history" class="panel">
                <h2>Your history</h2>
                <a class="settings-link" href="settings/import"><strong>Bring your history</strong><span class="muted small">import a TV Time, TV Time Out or Trakt export, dates included</span></a>
            </section>
        </Feature>

        <Feature Flag="@FeatureFlags.Plans">
            <section id="plan" class="panel">
                <h2>Plan</h2>
                <a class="settings-link" href="settings/plan"><strong>Your plan</strong><span class="muted small">what each plan includes</span></a>
                <Feature Flag="@FeatureFlags.FamilyPlan">
                    <a class="settings-link" href="settings/family"><strong>Your family</strong><span class="muted small">share one plan with up to @Plans.FamilyMembers people</span></a>
                </Feature>
            </section>
        </Feature>

        @if (isAdmin || isModerator)
        {
            <section id="admin" class="panel">
                <h2>Admin</h2>
                @if (isModerator)
                {
                    <a class="settings-link" href="moderation"><strong>Moderation</strong><span class="muted small">flagged posts and suggested corrections</span></a>
                    <Feature Flag="@FeatureFlags.Research">
                        <a class="settings-link" href="research"><strong>Research</strong><span class="muted small">shows being researched, and their saved versions</span></a>
                    </Feature>
                }
                @if (isAdmin)
                {
                    <a class="settings-link" href="settings/branding"><strong>Name and company</strong><span class="muted small">the app's name and colour, and who runs it, for the privacy policy and terms</span></a>
                    <a class="settings-link" href="settings/flags"><strong>Feature flags</strong><span class="muted small">turn features on or off for everyone</span></a>
                    <Feature Flag="@FeatureFlags.Plans">
                        <a class="settings-link" href="settings/plans"><strong>Plans</strong><span class="muted small">set people's plans</span></a>
                    </Feature>
                    <a class="settings-link" href="settings/revenue"><strong>Revenue</strong><span class="muted small">subscriptions, free accounts becoming paying ones, and affiliate commission</span></a>
                    <a class="settings-link" href="settings/financials"><strong>Financials</strong><span class="muted small">income, costs and what's left, month by month</span></a>
                    <Feature Flag="@FeatureFlags.Affiliates">
                        <a class="settings-link" href="settings/affiliates"><strong>Affiliate links</strong><span class="muted small">where-to-watch clicks, sales, commission and the programs</span></a>
                    </Feature>
                }
            </section>
        }

        <section id="data" class="panel">
            <h2>Your data</h2>
            <div class="actions">
                <button class="btn btn-quiet" @onclick="ExportAsync">Export my data</button>
                <button class="btn btn-quiet" @onclick="Auth.SignOutAsync">Sign out</button>
            </div>

            <h3>Delete account</h3>
            <p class="muted">Deletes your account and everything @Brand.AppName stores about you. This can't be undone.</p>
            @if (confirmDelete)
            {
                <label>Type DELETE to confirm <input @bind="deleteConfirmation" @bind:event="oninput" /></label>
                <div class="actions">
                    <button class="btn btn-danger" disabled="@(deleteConfirmation != "DELETE")" @onclick="DeleteAccountAsync">Delete my account</button>
                    <button class="btn btn-quiet" @onclick="() => confirmDelete = false">Cancel</button>
                </div>
            }
            else
            {
                <button class="btn btn-danger" @onclick="() => confirmDelete = true">Delete account…</button>
            }
        </section>
    </Authorized>
    <NotAuthorized>
        <SignInPrompt />
    </NotAuthorized>
</AuthorizeView>

</div>

@code {
    private bool spoilerShield;
    private bool? shareActivity;
    private bool privateProfile;

    /// <summary>
    /// Changes one Social setting (the other is null and kept), showing what the service saved.
    /// </summary>
    private async Task SetSocialAsync(bool? share, bool? isPrivate)
    {
        try
        {
            if (await Social.UpdateSettingsAsync(new SocialSettings(share, isPrivate)) is { } saved)
            {
                shareActivity = saved.ShareActivity;
                privateProfile = saved.Private ?? privateProfile;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            await LoadShareActivityAsync();
        }
    }

    /// <summary>
    /// Optional: Settings works without Social (flag off, or the service down).
    /// </summary>
    private async Task LoadShareActivityAsync()
    {
        try
        {
            var me = await Social.GetMeAsync();
            shareActivity = me?.ShareActivity;
            privateProfile = me?.Private ?? false;
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            shareActivity = null;
        }
    }

    private string? theme;

    // The flags page answers only admins, so asking it is how the page knows.
    private bool isAdmin;

    // Likewise for the moderation queue.
    private bool isModerator;

    // The header's toggle changes it too.
    private void OnThemeChanged() => InvokeAsync(async () =>
    {
        theme = await Theme.GetAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        if (avatarScript is not null)
        {
            try
            {
                await avatarScript.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is closing; its script objects go with it.
            }
        }
    }

    private async Task SetThemeAsync(string? value)
    {
        theme = value;
        await Theme.SetAsync(value);
    }

    private async Task SetSpoilerShieldAsync(bool on)
    {
        spoilerShield = on;
        await Shield.SetAsync(on);
    }

    private Profile? profile;
    private string displayName = "";
    private string? avatarUrl;
    private ElementReference avatarFile;
    private bool uploading;
    private IJSObjectReference? avatarScript;

    /// <summary>
    /// The side of the square an uploaded picture is shrunk to, in pixels: enough for the large avatar on a sharp screen.
    /// </summary>
    private const int AvatarSize = 256;
    private string timeZone = "UTC";
    private string region = "US";
    private string language = "en";

    private EditablePreferences? prefs;
    private List<RegisteredDevice>? devices;

    private bool confirmDelete;
    private string? deleteConfirmation;
    private string? error;
    private string? saved;

    protected override async Task OnInitializedAsync()
    {
        theme = await Theme.GetAsync();
        Theme.Changed += OnThemeChanged;
        spoilerShield = await Shield.IsOnAsync();
        await LoadShareActivityAsync();
        try
        {
            await Session.EnsureLoadedAsync();
            if (!Session.IsSignedIn)
            {
                return;
            }

            profile = await Identity.GetProfileAsync();
            isAdmin = await Identity.GetFeatureFlagsAsync() is not null;
            isModerator = await Ratings.GetModerationQueueAsync() is not null;
            if (profile is not null)
            {
                displayName = profile.DisplayName;
                avatarUrl = profile.AvatarUrl;
                timeZone = profile.TimeZone;
                region = profile.Region;
                language = profile.Language;
            }

            if (await Notifications.GetPreferencesAsync() is { } p)
            {
                prefs = new EditablePreferences
                {
                    NewEpisodes = p.NewEpisodes,
                    NewSeasons = p.NewSeasons,
                    StatusChanges = p.StatusChanges,
                    PushEnabled = p.PushEnabled,
                    WebPushEnabled = p.WebPushEnabled,
                    EmailEnabled = p.EmailEnabled,
                    Email = p.Email,
                    QuietHoursStart = p.QuietHoursStart,
                    QuietHoursEnd = p.QuietHoursEnd,
                    WeeklyDigest = p.WeeklyDigest,
                    DigestDay = p.DigestDay,
                    DigestHour = p.DigestHour,
                    SeasonVerdicts = p.SeasonVerdicts
                };
            }
            devices = await Notifications.GetDevicesAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private async Task UseDeviceTimeZoneAsync()
    {
        if (await Platform.GetDeviceTimeZoneAsync() is { } tz)
        {
            timeZone = tz;
        }
    }

    private async Task UploadAvatarAsync()
    {
        uploading = true;
        try
        {
            await RunAsync(async () =>
            {
                if (await PickedPictureAsync() is { } picture)
                {
                    Use(await Identity.UploadAvatarAsync(picture));
                    saved = "Picture saved.";
                }
            }, "That picture couldn't be used. Try a JPEG or PNG.");
        }
        finally
        {
            uploading = false;
        }
    }

    /// <summary>
    /// The picture just chosen, cropped and shrunk by avatar.js; null when nothing was chosen or it isn't a picture
    /// the browser can read (<see cref="error"/> then says so).
    /// </summary>
    private async Task<byte[]?> PickedPictureAsync()
    {
        avatarScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/TvTracker.UI/avatar.js");
        try
        {
            await using var picture = await avatarScript.InvokeAsync<IJSStreamReference?>("squared", avatarFile, AvatarSize);
            if (picture is null)
            {
                return null;
            }
            await using var stream = await picture.OpenReadStreamAsync(maxAllowedSize: 1024 * 1024);
            using var bytes = new MemoryStream();
            await stream.CopyToAsync(bytes);
            return bytes.ToArray();
        }
        catch (JSException)
        {
            error = "That file isn't a picture this can read. Try a JPEG or PNG.";
            return null;
        }
    }

    private Task RemoveAvatarAsync() => RunAsync(async () =>
    {
        Use(await Identity.RemoveAvatarAsync());
        saved = "Picture removed.";
    });

    private void Use(Profile? updated)
    {
        if (updated is not null)
        {
            profile = updated;
            Session.SetProfile(updated);
        }
    }

    private Task SaveProfileAsync() => RunAsync(async () =>
    {
        Use(await Identity.UpdateProfileAsync(new UpdateProfile(displayName, avatarUrl, timeZone, region, language)));
        saved = "Profile saved.";
    }, "Check the timezone (e.g. Africa/Johannesburg), the two-letter region, and that a picture's address starts with https://.");

    private Task SavePreferencesAsync() => RunAsync(async () =>
    {
        await Notifications.UpdatePreferencesAsync(new UpdateNotificationPreferences(
            prefs!.NewEpisodes, prefs.NewSeasons, prefs.StatusChanges, prefs.PushEnabled, prefs.WebPushEnabled,
            prefs.EmailEnabled, prefs.QuietHoursStart, prefs.QuietHoursEnd, prefs.WeeklyDigest, prefs.DigestDay, prefs.DigestHour, prefs.SeasonVerdicts));
        saved = "Notification settings saved.";
    });

    private Task PreviewDigestAsync() => RunAsync(async () => digest = await Notifications.GetDigestPreviewAsync());

    private Task EnablePushAsync() => RunAsync(async () =>
    {
        var ok = await Platform.EnablePushAsync();
        saved = ok ? "Notifications are on for this device." : "Notifications weren't turned on. Check your browser or phone settings.";
        devices = await Notifications.GetDevicesAsync();
    });

    private Task RemoveDeviceAsync(Guid id) => RunAsync(async () =>
    {
        await Notifications.RemoveDeviceAsync(id);
        devices = await Notifications.GetDevicesAsync();
    });

    private Task ExportAsync() => RunAsync(async () =>
    {
        var json = await Identity.ExportAsync();
        await Platform.SaveTextFileAsync($"tvtracker-export-{DateTime.UtcNow:yyyyMMdd}.json", json);
        saved = "Your data export is ready.";
    });

    private Task DeleteAccountAsync() => RunAsync(async () =>
    {
        await Identity.DeleteAccountAsync();
        await Auth.SignOutAsync();
    });

    private async Task RunAsync(Func<Task> action, string? validationHint = null)
    {
        error = null;
        saved = null;
        try
        {
            await action();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest && validationHint is not null)
        {
            error = validationHint;
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            error = ErrorNotice.Describe(ex);
        }
    }

    private DigestPreview? digest;

    private sealed class EditablePreferences
    {
        public bool NewEpisodes { get; set; }
        public bool NewSeasons { get; set; }
        public bool StatusChanges { get; set; }
        public bool PushEnabled { get; set; }
        public bool WebPushEnabled { get; set; }
        public bool EmailEnabled { get; set; }
        public string? Email { get; set; }
        public TimeOnly? QuietHoursStart { get; set; }
        public TimeOnly? QuietHoursEnd { get; set; }
        public bool WeeklyDigest { get; set; }
        public DayOfWeek DigestDay { get; set; }
        public int DigestHour { get; set; }
        public bool SeasonVerdicts { get; set; }
    }
}
