@inherits LayoutComponentBase
@implements IDisposable
@inject ConnectionState Connection
@inject UserSession Session
@inject ThemeStore Theme
@inject BrandingLoader BrandLoader

@* An accent colour set in Settings replaces the stylesheet's: as given on a light background, lightened on a dark one
   so it stays readable, and the second colour of the gradients follows it. *@
@if (Brand.AccentColor is { } accent)
{
    <style>
        :root {
            --accent: light-dark(@accent, color-mix(in oklab, @accent 62%, white));
            --accent-2: light-dark(color-mix(in oklab, @accent 78%, #7c3aed), color-mix(in oklab, @accent 50%, #c4b5fd));
        }
    </style>
}

<div class="app">
    <header class="app-header">
        <a class="brand" href="">@Brand.AppName</a>
        <NavMenu />
        <div class="header-account">
            <ThemeToggle />
            <AccountMenu />
        </div>
    </header>

    @if (Connection.IsOffline)
    {
        <div class="offline-banner" role="status">You're offline. Showing saved data; changes will sync when you're back online.</div>
    }

    <main class="app-main">
        @Body
    </main>

    @* The credit the catalog's source asks for: TVmaze's data is CC BY-SA, as are the Wikipedia overviews that come with
       Wikidata's (itself CC0), and TheTVDB's licence words its own. *@
    <footer class="app-footer muted small">
        <p class="footer-links"><a href="privacy">Privacy</a><a href="terms">Terms</a></p>
        @switch (Brand.Catalog.Licence)
        {
            case CatalogLicence.Invented:
                <text>Invented show data, for development</text>
                break;
            case CatalogLicence.Own:
                <text>Metadata provided by <CatalogCredits />. Please consider adding missing information or subscribing.</text>
                break;
            default:
                <text>Show data from <CatalogCredits />
                    (<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA</a>)</text>
                break;
        }
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Connection.Changed += OnChanged;
        Session.Changed += OnChanged;
        Brand.Changed += OnChanged;
        await BrandLoader.EnsureFreshAsync();
        await Session.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.ApplySavedAsync();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.Changed -= OnChanged;
        Session.Changed -= OnChanged;
        Brand.Changed -= OnChanged;
    }
}
