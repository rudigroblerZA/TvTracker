@inherits LayoutComponentBase
@implements IDisposable
@inject ConnectionState Connection
@inject UserSession Session
@inject ThemeStore Theme

<div class="app">
    <header class="app-header">
        <a class="brand" href="">@Brand.AppName</a>
        <NavMenu />
        <div class="header-account">
            <ThemeToggle />
            <AccountMenu />
        </div>
    </header>

    @if (Connection.IsOffline)
    {
        <div class="offline-banner" role="status">You're offline. Showing saved data; changes will sync when you're back online.</div>
    }

    <main class="app-main">
        @Body
    </main>

    @* The credit the catalog's source asks for: TVmaze's data is CC BY-SA, TheTVDB's licence words its own, and
       Wikidata's (CC0) needs none but is named all the same. *@
    <footer class="app-footer muted small">
        <p class="footer-links"><a href="privacy">Privacy</a><a href="terms">Terms</a></p>
        @if (Brand.Catalog.Url is not { } source)
        {
            <text>Invented show data, for development</text>
        }
        else if (Brand.Catalog.OwnLicence)
        {
            <text>Metadata provided by <a href="@source" target="_blank" rel="noopener">@Brand.Catalog.Name</a>.
                Please consider adding missing information or subscribing.</text>
        }
        else
        {
            <text>Show data from <a href="@source" target="_blank" rel="noopener">@Brand.Catalog.Name</a>
                (<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA</a>)</text>
        }
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Connection.Changed += OnChanged;
        Session.Changed += OnChanged;
        await Session.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.ApplySavedAsync();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.Changed -= OnChanged;
        Session.Changed -= OnChanged;
    }
}
