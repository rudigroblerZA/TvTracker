@inject CatalogClient Catalog

@* An episode's memorable lines, behind the spoiler shield until it's watched, like its summary. *@
@if (quotes is { Quotes.Count: > 0 } q)
{
    <section aria-labelledby="episode-lines-title">
        <h2 id="episode-lines-title">Memorable lines</h2>
        <Spoiler Hidden="!Watched" Placeholder="@($"{q.Quotes.Count} {(q.Quotes.Count == 1 ? "quote" : "quotes")} hidden: you haven't watched this yet")">
            <QuoteList Quotes="q.Quotes" PageUrl="@q.PageUrl" More="q.More" />
        </Spoiler>
    </section>
}

@code {
    [Parameter, EditorRequired] public Guid EpisodeId { get; set; }

    [Parameter] public bool Watched { get; set; }

    private EpisodeQuotes? quotes;

    protected override async Task OnParametersSetAsync()
    {
        if (quotes?.EpisodeId == EpisodeId)
        {
            return;
        }
        try
        {
            quotes = await Catalog.GetEpisodeQuotesAsync(EpisodeId);
        }
        catch (HttpRequestException)
        {
            // Extra: the episode page works without it.
            quotes = null;
        }
    }
}
