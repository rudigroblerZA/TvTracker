@inject AnalyticsClient Analytics
@inject UserSession Session

@* Insights for signed-in users; computed hourly, so a newly added show shows nothing until the next run. *@
@if (insights is not null)
{
    <section class="insights">
        <h2>Insights</h2>

        @if (Highlighted() is { Count: > 0 } prolific)
        {
            <div class="panel made-by">
                @foreach (var creative in prolific)
                {
                    <div class="made-by-person">
                        <Poster Title="@creative.Name" Url="@creative.PhotoUrl" Size="small" />
                        <div>
                            <div class="muted small">From a prolific @(creative.IsCreator ? "creator" : "producer")</div>
                            <div><a href="people/@creative.PersonId"><strong>@creative.Name</strong></a> <span class="muted small">· @RolesText(creative.Roles)</span></div>
                            <div class="small">@CareerText(creative.Career!)</div>
                            @if (creative.Career!.NotableShows.Count > 0)
                            {
                                <div class="muted small">Known for @string.Join(", ", creative.Career.NotableShows.Take(5))</div>
                            }
                            @if (creative.OtherShows.Count > 0)
                            {
                                <div class="small">
                                    In TV Tracker:
                                    @for (var i = 0; i < Math.Min(4, creative.OtherShows.Count); i++)
                                    {
                                        var other = creative.OtherShows[i];
                                        <a href="shows/@other.Id">@other.Title</a>@(i < Math.Min(4, creative.OtherShows.Count) - 1 ? ", " : "")
                                    }
                                    @if (creative.OtherShows.Count > 4)
                                    {
                                        <span class="muted"> and @(creative.OtherShows.Count - 4) more</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        @if (Creatives?.Where(c => c.IsCreator && !Highlighted().Contains(c)).ToList() is { Count: > 0 } creators)
        {
            <p class="muted small">
                Created by
                @for (var i = 0; i < creators.Count; i++)
                {
                    var creator = creators[i];
                    <a href="people/@creator.PersonId">@creator.Name</a>@(i < creators.Count - 2 ? ", " : i == creators.Count - 2 ? " and " : "")
                }
            </p>
        }

        @* The prolific tag repeats the "made by" block above, when that shows. *@
        @if (insights.Tags?.Where(t => t.Key != "prolific-creator" || Highlighted().Count == 0).ToList() is { Count: > 0 } tags)
        {
            <ul class="show-tags">
                @foreach (var tag in tags)
                {
                    <li class="show-tag tag-@tag.Key">
                        <strong>@tag.Label</strong>
                        @* The space is inside the span: Blazor drops text nodes that are only whitespace. *@
                        <span class="muted small"> @tag.Detail</span>
                    </li>
                }
            </ul>
        }

        <InsightHighlights Insights="insights" />

        <div class="stat-tiles">
            @if (insights.Rating.External is { } external)
            {
                <div class="stat"><div class="stat-value rating-@Format.RatingTone(external)">@Format.Rating(external)</div><div class="muted">TVmaze rating</div></div>
            }
            @if (insights.Rating.Ours is { } ours)
            {
                <div class="stat"><div class="stat-value">@Format.Stars(ours, insights.Rating.OurCount)</div><div class="muted">TV Tracker users</div></div>
            }
            @if (insights.Run.AiredEpisodes > 0)
            {
                <div class="stat">
                    <div class="stat-value">@Format.Duration(insights.Run.RuntimeMinutes)</div>
                    <div class="muted">to watch it all · @insights.Run.AiredEpisodes episodes</div>
                </div>
            }
            @if (insights.Momentum is { } momentum)
            {
                <div class="stat">
                    <div class="stat-value">@momentum.Followers</div>
                    <div class="muted">following · @Format.Growth(momentum.RecentFollows, momentum.PreviousFollows)</div>
                    @{ var peak = Math.Max(1, momentum.NewFollowsByWeek.Max()); }
                    <div class="sparkline" aria-label="New follows per week over the last 8 weeks">
                        @foreach (var week in momentum.NewFollowsByWeek)
                        {
                            <span style="height:@(10 + 90 * week / peak)%" title="@week"></span>
                        }
                    </div>
                </div>
            }
            @if (insights.Viewing is { CompletionRate: { } completion } viewingTile)
            {
                <div class="stat">
                    <div class="stat-value">@Format.Percent(completion)</div>
                    <div class="muted">of @viewingTile.Viewers viewers are up to date</div>
                </div>
            }
        </div>

        <div class="insight-grid">
            @{ var ratedSeasons = insights.Seasons.Where(s => s.Rating.External is not null).ToList(); }
            @if (ratedSeasons.Count > 1)
            {
                // Scaled across this show's range (not 0-10), so a one-point difference between seasons is visible.
                var low = ratedSeasons.Min(s => s.Rating.External!.Value) - 0.5;
                var high = ratedSeasons.Max(s => s.Rating.External!.Value);
                // Long runs fit the card: values on the best and weakest only, labels every fifth season.
                var dense = ratedSeasons.Count > DenseSeasons;
                <div class="insight-card">
                    <h3>Season by season</h3>
                    @if (insights.Trend is { } trend)
                    {
                        <p class="muted small">@Format.Trend(trend)</p>
                    }
                    <div class="season-chart @(dense ? "dense" : "")" role="img" aria-label="@SeasonChartLabel(ratedSeasons)">
                        @foreach (var season in ratedSeasons)
                        {
                            var rating = season.Rating.External!.Value;
                            // Best and weakest only mean something among three or more seasons.
                            var mark = ratedSeasons.Count < 3 ? ""
                                : season.Number == insights.BestSeason?.Number ? "best" : season.Number == insights.WorstSeason?.Number ? "worst" : "";
                            <div class="season-col @mark" title="@SeasonTitle(season)">
                                <span class="season-value">@(dense && mark == "" ? "" : Format.Rating(rating))</span>
                                <span class="season-bar" style="height:@BarWidth(rating, low, high)%"></span>
                                <span class="season-label">@(dense && season.Number != 1 && season.Number % 5 != 0 ? "" : $"S{season.Number}")</span>
                            </div>
                        }
                    </div>
                    @if (ratedSeasons.Count >= 3)
                    {
                        <p class="chart-legend small muted"><span class="swatch best"></span><span> best season </span><span class="swatch worst"></span><span> weakest</span></p>
                    }
                    @if (insights.Patterns?.Arc is { } arc)
                    {
                        <p class="small">@ArcText(arc)</p>
                    }
                </div>
            }

            @if (insights.TopEpisodes.Count > 0 || insights.Patterns is { } || insights.Histograms is { })
            {
                var patterns = insights.Patterns;
                <div class="insight-card">
                    <h3>Episodes</h3>
                    @if (patterns?.Consistency is { } consistency)
                    {
                        <p class="small">@ConsistencyText(consistency)</p>
                    }
                    @if (patterns?.Finales is { } finales)
                    {
                        <p class="small">@FinaleText(finales)</p>
                    }
                    @if (insights.TopEpisodes.Count > 0)
                    {
                        <h4>Top episodes</h4>
                        <ol class="episode-rank">
                            @foreach (var episode in insights.TopEpisodes)
                            {
                                <li>
                                    @if (episode.Rating.External is { } r)
                                    {
                                        <span class="rating-pill rating-@Format.RatingTone(r)">@Format.Rating(r)</span>
                                    }
                                    <span class="code">@Format.EpisodeCode(episode.SeasonNumber, episode.EpisodeNumber)</span>
                                    <Spoiler Hidden="!Seen(episode.EpisodeId)"><a href="episodes/@episode.EpisodeId">@episode.Title</a></Spoiler>
                                    @if (episode.Rating.Ours is { } o)
                                    {
                                        <span class="muted small">@($" · {Format.Stars(o, episode.Rating.OurCount)}")</span>
                                    }
                                </li>
                            }
                        </ol>
                    }
                    @if (patterns?.SeasonBests.Count > 1)
                    {
                        <details class="season-bests" open="@(patterns.SeasonBests.Count <= 6)">
                            <summary>Best episode of each season</summary>
                            <ol class="episode-rank">
                                @foreach (var seasonBest in patterns.SeasonBests)
                                {
                                    <li>
                                        <span class="rating-pill rating-@Format.RatingTone(seasonBest.Rating)">@Format.Rating(seasonBest.Rating)</span>
                                        <span class="code">@Format.EpisodeCode(seasonBest.SeasonNumber, seasonBest.EpisodeNumber)</span>
                                        <Spoiler Hidden="!Seen(seasonBest.EpisodeId)"><a href="episodes/@seasonBest.EpisodeId">@seasonBest.Title</a></Spoiler>
                                    </li>
                                }
                            </ol>
                        </details>
                    }
                    @if (insights.Histograms is { } histograms && histograms.ExternalEpisodes.Count > 1)
                    {
                        var most = Math.Max(1, histograms.ExternalEpisodes.Max(b => b.Count));
                        <h4>Episodes by TVmaze rating</h4>
                        <div class="columns" aria-label="Episodes by TVmaze rating">
                            @foreach (var bucket in histograms.ExternalEpisodes)
                            {
                                <div class="column" title="@bucket.Count episodes rated @bucket.From.ToString("0.0")–@((bucket.From + 0.5).ToString("0.0"))">
                                    <span class="rating-fill-@Format.RatingTone(bucket.From + 0.25)" style="height:@(100 * bucket.Count / most)%"></span>
                                    <span class="column-label">@bucket.From.ToString("0.#")</span>
                                </div>
                            }
                        </div>
                    }
                    @if (insights.Histograms?.OurStars is { } stars)
                    {
                        var most = Math.Max(1, stars.Max());
                        <h4>TV Tracker users (@stars.Sum() ratings)</h4>
                        <ul class="bars">
                            @for (var star = 5; star >= 1; star--)
                            {
                                <li>
                                    <span class="bar-label">@star ★</span>
                                    <span class="bar" style="width:@(100 * stars[star - 1] / most)%"></span>
                                    <span class="muted small">@stars[star - 1]</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            <Feature Flag="@FeatureFlags.GetsGood"><GetsGoodPanel GetsGood="insights.GetsGood" DropOff="insights.Viewing?.DropOff" Watched="Watched" /></Feature>
            <Feature Flag="@FeatureFlags.Endings"><LandingPanel Landing="insights.Landing" /></Feature>
            <Feature Flag="@FeatureFlags.Forecasts"><ShowOutlookPanel ShowId="insights.ShowId" Outlook="insights.Outlook" /></Feature>
            <Feature Flag="@FeatureFlags.ShowDna"><ShowDnaPanel Dna="insights.Dna" /></Feature>

            @if (insights.Viewing is { } viewing && (viewing.Seasons.Count > 0 || viewing.DropOff is not null))
            {
                <div class="insight-card">
                    <h3>Who's watching</h3>
                    @if (viewing.DropOff is { } drop)
                    {
                        <p>
                            Most viewers who stop do so after
                            <strong>@Format.EpisodeCode(drop.SeasonNumber, drop.EpisodeNumber)<Spoiler Hidden="true">@(" " + drop.Title)</Spoiler></strong>
                            <span class="muted">(@Format.Percent(drop.Share) of viewers)</span>.
                        </p>
                    }
                    @if (viewing.Seasons.Count > 1)
                    {
                        var most = Math.Max(1, viewing.Seasons.Max(s => s.Viewers));
                        <ul class="bars">
                            @foreach (var season in viewing.Seasons)
                            {
                                <li>
                                    <span class="bar-label">Season @season.Number</span>
                                    <span class="bar" style="width:@(100 * season.Viewers / most)%"></span>
                                    <span class="muted small">@season.Viewers viewers</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (insights.SharedCast.Count > 0 || insights.Run.LongestBreak is { Days: > 180 })
            {
                <div class="insight-card">
                    @if (insights.SharedCast.Count > 0)
                    {
                        <h3>Shared cast</h3>
                        <ul class="shared-cast">
                            @foreach (var shared in insights.SharedCast)
                            {
                                <li>
                                    @if (shared.PersonId is { } personId)
                                    {
                                        <a href="people/@personId"><strong>@shared.PersonName</strong></a>
                                    }
                                    else
                                    {
                                        <strong>@shared.PersonName</strong>
                                    }
                                    @(shared.SameCharacter ? " also appears as " : " is also in ")
                                    <a href="shows/@shared.OtherShowId">@shared.OtherShowTitle</a>
                                    @if (!string.IsNullOrEmpty(shared.CharacterThere))
                                    {
                                        @* The space is inside the span: Blazor drops text nodes that are only whitespace. *@
                                        <span class="muted"> (@shared.CharacterThere)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (insights.Run.LongestBreak is { Days: > 180 } pause)
                    {
                        <p class="muted small">Longest break: @Gap(pause.Days) between seasons @pause.AfterSeason and @pause.BeforeSeason.</p>
                    }
                </div>
            }
        </div>

        <p class="muted small">Ratings from <a href="https://www.tvmaze.com" target="_blank" rel="noopener">TVmaze</a> and TV Tracker users. Updated hourly.</p>
    </section>
}

@code {
    [Parameter, EditorRequired] public Guid ShowId { get; set; }

    /// <summary>Who made the show, from the catalog; prolific creators and producers are highlighted.</summary>
    [Parameter] public IReadOnlyList<Creative>? Creatives { get; set; }

    /// <summary>The episodes the user has watched, so the spoiler shield can hide the titles of the rest.</summary>
    [Parameter] public IReadOnlySet<Guid>? Watched { get; set; }

    private bool Seen(Guid episodeId) => Watched?.Contains(episodeId) == true;

    private ShowInsights? insights;

    protected override async Task OnParametersSetAsync()
    {
        insights = null;
        try
        {
            await Session.EnsureLoadedAsync();
            if (!Session.IsSignedIn)
            {
                return;
            }

            insights = await Analytics.GetShowInsightsAsync(ShowId);
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            // Insights are extra: the rest of the show page works without them.
        }
    }

    private static string RatingText(SeasonHighlight highlight) =>
        highlight.Source == "external" ? Format.Rating(highlight.Rating) : $"★ {highlight.Rating:0.0}";

    /// <summary>More seasons than this, and the chart squeezes to fit rather than labelling every column.</summary>
    private const int DenseSeasons = 12;

    private static string SeasonTitle(SeasonStats season) =>
        $"Season {season.Number}: {Format.Rating(season.Rating.External!.Value)} on TVmaze" +
        (season.Rating.Ours is { } ours ? $", {Format.Stars(ours, season.Rating.OurCount)} from TV Tracker users" : "");

    private static string SeasonChartLabel(List<SeasonStats> seasons) =>
        "Season ratings on TVmaze: " + string.Join(", ", seasons.Select(s => $"season {s.Number} {Format.Rating(s.Rating.External!.Value)}"));

    private static int BarWidth(double rating, double low, double high) =>
        high <= low ? 100 : (int)Math.Round(10 + 90 * (rating - low) / (high - low));

    /// <summary>
    /// The prolific people to feature: the most prolific one, plus any other prolific creator. A big producer's
    /// production company often brings several prolific executive producers (Dick Wolf's shows list three or four);
    /// only the best known is worth a line.
    /// </summary>
    private List<Creative> Highlighted()
    {
        var prolific = (Creatives ?? []).Where(c => c.Career?.Prolific == true).OrderByDescending(c => c.Career!.Shows).ToList();
        return prolific.Take(1).Concat(prolific.Skip(1).Where(c => c.IsCreator)).ToList();
    }

    private static string RolesText(IReadOnlyList<string> roles) =>
        string.Join(" and ", roles.Select(r => r.ToLowerInvariant()).Select(r => r == "executive producer" ? "executive producer" : r));

    private static string CareerText(Career career)
    {
        var parts = new List<string>();
        if (career.Created > 0) parts.Add($"created {career.Created}");
        if (career.ExecutiveProduced > 0) parts.Add($"executive producer on {career.ExecutiveProduced}");
        return $"{career.Shows} shows behind the camera" + (parts.Count > 0 ? $" ({string.Join(", ", parts)})" : "");
    }

    private static string Capitalize(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private static string ConsistencyText(Consistency c) => c.Label switch
    {
        "steady" => $"Episodes rarely stray far from the show's usual standard (spread {c.Spread:0.00}).",
        "rollercoaster" => $"Episode quality swings widely, from standouts to misfires (spread {c.Spread:0.00}).",
        _ => $"Some episodes stand out, some dip (spread {c.Spread:0.00})."
    };

    private static string ArcText(Arc arc) =>
        arc.PeakIsLatest ? $"Still peaking: season {arc.PeakSeason} is its best yet ({Format.Rating(arc.PeakRating)})."
        : arc.DeclineFromSeason is { } from ? $"Peaked in season {arc.PeakSeason} ({Format.Rating(arc.PeakRating)}); from season {from} on, it never got back there."
        : $"Peaked in season {arc.PeakSeason} ({Format.Rating(arc.PeakRating)}) and held up afterwards.";

    private static string FinaleText(FinaleStats f) =>
        f.Seasons == 1
            ? $"The season finale rated {Math.Abs(f.AverageDifference):0.0} {(f.AverageDifference >= 0 ? "above" : "below")} the rest of the season."
            : f.BeatSeasonAverage * 2 >= f.Seasons
                ? $"Finales deliver: {f.BeatSeasonAverage} of {f.Seasons} rated above the rest of their season, by {f.AverageDifference:+0.0;-0.0;0.0} on average."
                : $"Finales tend to fall short: only {f.BeatSeasonAverage} of {f.Seasons} rated above the rest of their season ({f.AverageDifference:+0.0;-0.0;0.0} on average).";

    private static string Gap(int days) => days >= 365 ? $"{days / 365.0:0.#} years" : days >= 60 ? $"{days / 30} months" : $"{days} days";
}
