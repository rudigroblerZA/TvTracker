@inject AnalyticsClient Analytics

@* Home's line from the time machine: this week's best-known premieres and finales from past years. *@
@if (moments.Count > 0)
{
    <section>
        <div class="section-head">
            <h2>This week in TV history</h2>
            <a href="time-machine">Time machine</a>
        </div>
        <ul class="time-moments">
            @foreach (var (episode, what) in moments)
            {
                <li>
                    <a href="shows/@episode.ShowId"><strong>@episode.ShowTitle</strong></a><span>@($" {what} {YearsAgo(episode)}")</span><span class="muted">@($" ({episode.AiredAtUtc.UtcDateTime:d MMMM yyyy})")</span>
                </li>
            }
        </ul>
    </section>
}

@code {
    private const int Max = 4;

    private static string YearsAgo(TimeMachineEpisode episode)
    {
        var years = DateTime.UtcNow.Year - episode.AiredAtUtc.Year;
        return years > 1 ? $"{years} years ago" : years == 1 ? "a year ago" : "this year";
    }

    private List<(TimeMachineEpisode Episode, string What)> moments = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Analytics.GetTimeMachineAsync(null) is { } machine)
            {
                // Alternate premieres and finales, best known first.
                moments = machine.Premieres.Select(e => (e, "premiered"))
                    .Zip(machine.Finales.Select(e => (e, "ended")), (a, b) => new[] { a, b })
                    .SelectMany(x => x)
                    .Concat(machine.Premieres.Skip(machine.Finales.Count).Select(e => (e, "premiered")))
                    .Concat(machine.Finales.Skip(machine.Premieres.Count).Select(e => (e, "ended")))
                    .Take(Max)
                    .ToList();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            // Extra on Home.
        }
    }
}
