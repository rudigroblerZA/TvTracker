@implements IDisposable
@inject RatingsClient Ratings

@* Favourite character, on an episode's page: one vote for the cast member who stood out, open once the episode is
   watched. Counts stay hidden until then, since who stood out gives the episode away. *@
@if (votes is not null && people.Count > 0)
{
    <section class="character-vote" aria-labelledby="character-vote-title">
        <h2 id="character-vote-title">Favourite character</h2>
        @if (votes.Locked)
        {
            <p class="muted">@(Watched ? "Voting opens a moment after you mark the episode watched." : "Watch the episode to vote for who stood out, and to see who everyone else picked.")</p>
        }
        else
        {
            <p class="muted">@(votes.Total == 0 ? "Who stood out in this one? Yours is the first vote." : $"Who stood out in this one? {CharacterVoteRow.Count(votes.Total)} so far.")</p>
            <ul class="character-votes">
                @foreach (var member in Shown)
                {
                    var count = CountFor(member.PersonId);
                    var mine = votes.Mine == member.PersonId;
                    <li>
                        <button type="button" class="character-choice @(mine ? "mine" : "")" aria-pressed="@(mine ? "true" : "false")" disabled="@busy"
                                @onclick="() => VoteAsync(member.PersonId)">
                            <CharacterVoteRow Member="member" Votes="count" Total="votes.Total" />
                        </button>
                    </li>
                }
            </ul>
            @if (people.Count > Few)
            {
                <button type="button" class="btn btn-quiet" @onclick="() => everyone = !everyone">@(everyone ? "Show fewer" : $"Show all {people.Count}")</button>
            }
            @if (votes.Mine is not null)
            {
                <p class="muted small">Pick someone else to change your vote, or yours again to take it back.</p>
            }
            <ErrorNotice Message="@error" />
        }
    </section>
}

@code {
    /// <summary>
    /// How many of the cast are listed before "Show all".
    /// </summary>
    private const int Few = 8;

    [Parameter, EditorRequired] public Guid EpisodeId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<CastMember> Cast { get; set; } = [];

    /// <summary>
    /// Whether the page has the episode as watched: when that changes, the votes are asked for again.
    /// </summary>
    [Parameter] public bool Watched { get; set; }

    private EpisodeCharacterVotes? votes;

    /// <summary>
    /// The cast that can be voted for: one entry per person the catalog knows.
    /// </summary>
    private IReadOnlyList<CastMember> people = [];
    private IReadOnlyList<CastMember>? peopleFrom;
    private Dictionary<Guid, int> counts = [];
    private (Guid Episode, bool Watched)? loaded;
    private CancellationTokenSource? waiting;

    private bool busy;
    private bool everyone;
    private string? error;

    /// <summary>
    /// How long to wait before asking again whether Ratings has heard of a watch just marked: it gets the news a
    /// moment after the page does.
    /// </summary>
    private static readonly TimeSpan[] Retries = [TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(4)];

    /// <summary>
    /// How often it asks after that.
    /// </summary>
    private static readonly TimeSpan Later = TimeSpan.FromSeconds(20);

    /// <summary>
    /// The first few as billed, plus anyone further down who has votes; most votes first.
    /// </summary>
    private IEnumerable<CastMember> Shown => people
        .Where((m, i) => everyone || i < Few || CountFor(m.PersonId) > 0)
        .OrderByDescending(m => CountFor(m.PersonId));

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(peopleFrom, Cast))
        {
            (peopleFrom, people) = (Cast, Cast.Where(m => m.PersonId != Guid.Empty).DistinctBy(m => m.PersonId).ToList());
        }
        if (people.Count == 0 || loaded == (EpisodeId, Watched))
        {
            return;
        }
        if (loaded is { } last && last.Episode != EpisodeId)
        {
            // Another episode in the same place, where the page didn't key the section by episode: nothing of the
            // last one's is left to show or to vote from.
            (votes, counts, everyone, error) = (null, [], false, null);
        }
        loaded = (EpisodeId, Watched);
        waiting?.Cancel();
        if (!Watched)
        {
            // Locked without asking: Ratings hears of an unwatch a moment after the page does, and would still answer
            // with the counts.
            Show(Unwatched);
            return;
        }
        waiting = new CancellationTokenSource();
        await LoadUntilOpenAsync(waiting.Token);
    }

    /// <summary>
    /// Asks for a watched episode's votes until they come unlocked: Ratings hears of a watch a moment after the page
    /// does, so soon again at first (<see cref="Retries"/>), then every <see cref="Later"/> for news that is late or
    /// a service that isn't answering. Ends when <paramref name="stop"/> is cancelled: a newer load, or the page left.
    /// </summary>
    private async Task LoadUntilOpenAsync(CancellationToken stop)
    {
        try
        {
            for (var asked = 0; ; asked++)
            {
                try
                {
                    var latest = await Ratings.GetCharacterVotesAsync(EpisodeId, stop);
                    // An answer that arrives as a newer load takes over (the episode was unmarked, say) is out of date.
                    stop.ThrowIfCancellationRequested();
                    Show(latest);
                    if (latest is not { Locked: true })
                    {
                        // Open, or no such thing here (the feature is off).
                        return;
                    }
                }
                catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
                {
                    // An extra on the page: without it (unreachable, or an answer that isn't the votes), the page
                    // stands, and it is asked for again.
                }
                // Shown now: this method goes on waiting, so the page wouldn't draw it otherwise.
                StateHasChanged();
                await Task.Delay(asked < Retries.Length ? Retries[asked] : Later, stop);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or SignInRequiredException)
        {
            // Overtaken or left; or signed out, when there is nothing to ask for.
        }
    }

    /// <summary>
    /// What the section shows for an episode the page has as unwatched: as Ratings answers for one, with no counts.
    /// </summary>
    private static readonly EpisodeCharacterVotes Unwatched = new(Locked: true, Total: 0, Counts: [], Mine: null);

    private void Show(EpisodeCharacterVotes? latest)
    {
        if (latest is not null)
        {
            (votes, counts) = (latest, latest.Counts.ToDictionary(c => c.PersonId, c => c.Votes));
        }
    }

    private int CountFor(Guid personId) => counts.GetValueOrDefault(personId);

    private async Task VoteAsync(Guid personId)
    {
        (busy, error) = (true, null);
        try
        {
            var answer = votes?.Mine == personId
                ? await Ratings.RemoveCharacterVoteAsync(EpisodeId)
                : await Ratings.VoteCharacterAsync(EpisodeId, personId);
            Show(answer);
            if (answer is null)
            {
                // No such thing any more (voting was switched off while the page was open): say so, not nothing.
                error = "Voting isn't available right now.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException or System.Text.Json.JsonException)
        {
            error = ErrorNotice.Describe(ex);
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose() => waiting?.Cancel();
}
