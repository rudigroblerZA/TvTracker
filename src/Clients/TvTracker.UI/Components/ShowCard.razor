@implements IDisposable
@inject ShowTagStore Tags

<a class="show-card" href="shows/@ShowId">
    <Poster Title="@Title" Url="@PosterUrl" />
    <div class="show-card-body">
        <div class="show-card-title">@Title</div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="muted small">@Subtitle</div>
        }
        @if (Tags.ForCard(ShowId, PreferredTag) is { Count: > 0 } tags)
        {
            <div class="card-tags">
                @foreach (var tag in tags)
                {
                    <span class="card-tag" title="@tag.Detail">@tag.Label</span>
                }
            </div>
        }
        @ChildContent
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Guid ShowId { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? PosterUrl { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A tag key to show first when the show has it, e.g. the tag search results are filtered by.</summary>
    [Parameter] public string? PreferredTag { get; set; }

    protected override void OnInitialized() => Tags.Changed += OnTagsChanged;

    protected override void OnParametersSet() => Tags.Request(ShowId);

    private void OnTagsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tags.Changed -= OnTagsChanged;
}
