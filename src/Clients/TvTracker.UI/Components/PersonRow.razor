@* A person in a list (search results, followers, following) with a follow button. *@
<li class="person-row">
    <a class="avatar" href="users/@Person.UserId" aria-hidden="true" tabindex="-1">@FeedItemRow.Initial(Person.DisplayName)</a>
    <div class="feed-body">
        <a class="strong" href="users/@Person.UserId">@Person.DisplayName</a>
        <div class="muted small">
            <span>@Person.Followers follower@(Person.Followers == 1 ? "" : "s") · @Person.Following following</span>
            @if (Person.FollowsYou)
            {
                <span class="tag">Follows you</span>
            }
        </div>
    </div>
    <FollowButton Person="Person" />
</li>

@code {
    [Parameter, EditorRequired] public SocialPerson Person { get; set; } = null!;
}
