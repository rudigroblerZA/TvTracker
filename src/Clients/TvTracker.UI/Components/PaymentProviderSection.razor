@inject IdentityClient Identity
@inject FinancialsClient Books

@* The payment provider, on the admins' financials page: which one sells plans and Stripe's keys (Identity.API), and
   the rate it charges, which the fee estimate above uses (Financials.API). Two forms, saved on their own, since two
   services keep them. Keys go in and never come back: the page only says whether each is set. *@
@if (settings is not null || fees is not null)
{
    <section class="payment-provider">
        <h2>Payment provider</h2>
        <p class="muted">Who takes the money when someone buys a plan. What you set here takes the place of the deployment's own configuration.</p>
        @if (settings is null)
        {
            <p class="notice" role="status">The provider's settings couldn't be fetched just now. The fee rate can still be changed.</p>
        }
        else
        {

        <p class="@(settings.Missing.Count > 0 ? "notice" : "")" role="status">
            @if (settings.Provider.Length == 0)
            {
                <span><strong>Plans aren't being sold.</strong> No provider is chosen.</span>
            }
            else if (settings.Missing.Count > 0)
            {
                <span><strong>@($"{ProviderName(settings.Provider)} is chosen, but plans can't be bought yet.")</strong> Still needed: @string.Join(" ", settings.Missing)</span>
            }
            else
            {
                <span><strong>@($"Plans are sold through {ProviderName(settings.Provider)}.")</strong></span>
            }
            <span class="muted small">@($" Set in {(settings.ProviderFrom == FromSettings ? "these settings" : "the deployment's configuration")}.")</span>
        </p>

        <EditForm Model="form" OnSubmit="SaveProviderAsync" class="panel stack" aria-label="Payment provider" Context="providerForm">
            <label>
                Provider
                <select id="payment-provider" @bind="form.Provider">
                    <option value="">None: don't sell plans</option>
                    @foreach (var provider in settings.Providers)
                    {
                        <option value="@provider">@ProviderName(provider)</option>
                    }
                </select>
            </label>

            @if (StripeShown)
            {
                <label>
                    Stripe secret key <span class="muted small">@KeyState(settings.StripeSecretKey)</span>
                    <input id="stripe-secret-key" type="password" autocomplete="off" @bind="form.SecretKey" maxlength="255" disabled="@(!settings.CanStoreSecrets)"
                           placeholder="@(settings.StripeSecretKey.Length > 0 ? "Leave empty to keep the one in force" : "sk_live_… or sk_test_…")" />
                </label>
                <label>
                    Stripe webhook signing secret <span class="muted small">@KeyState(settings.StripeWebhookSecret)</span>
                    <input id="stripe-webhook-secret" type="password" autocomplete="off" @bind="form.WebhookSecret" maxlength="255" disabled="@(!settings.CanStoreSecrets)"
                           placeholder="@(settings.StripeWebhookSecret.Length > 0 ? "Leave empty to keep the one in force" : "whsec_…")" />
                </label>
                @if (settings.KeysUnreadable)
                {
                    <p class="notice">A key saved here can't be read any more: the deployment's settings key (PAYMENT_SETTINGS_KEY) has changed since. Enter the keys again.</p>
                }
                @if (!settings.CanStoreSecrets)
                {
                    <p class="muted small">Keys can't be saved here: this deployment has no key to encrypt them with (PAYMENT_SETTINGS_KEY). Set them in its configuration.</p>
                }
                <label>
                    Customer portal link <span class="muted small">(optional; shown to subscribers as "manage billing")</span>
                    <input id="stripe-portal" type="url" @bind="form.PortalUrl" maxlength="512" placeholder="https://billing.stripe.com/p/login/…" />
                </label>
                <p class="muted small">
                    @if (settings.WebhookUrl is { } webhook)
                    {
                        <span>In Stripe, send webhooks to <code>@webhook</code>.</span>
                    }
                    else
                    {
                        <span>In Stripe, send webhooks to Identity's <code>/api/v1/payments/webhooks/stripe</code> (README, Payments).</span>
                    }
                    @if (settings.ReturnUrl is { Length: > 0 } back)
                    {
                        <span>@($" Buyers come back to {back}.")</span>
                    }
                </p>
            }

            <div class="actions">
                <button class="btn" type="submit" disabled="@busy">Save</button>
                @if (settings.HasStored)
                {
                    @if (confirmClear)
                    {
                        <button class="btn btn-danger" type="button" disabled="@busy" @onclick="ClearProviderAsync">Yes, delete what was set here</button>
                        <button class="btn btn-quiet" type="button" @onclick="() => confirmClear = false">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-quiet" type="button" disabled="@busy" @onclick="() => confirmClear = true">Go back to configuration</button>
                    }
                }
                @if (notice is not null)
                {
                    <span class="muted small" role="status">@notice</span>
                }
            </div>
            @if (settings.UpdatedAtUtc is { } updated)
            {
                <p class="muted small">@($"Last saved {updated:d MMM yyyy, HH:mm} UTC{(settings.UpdatedBy is { Length: > 0 } by ? $" by {by}" : "")}.")</p>
            }
            <ErrorNotice Message="@error" />
        </EditForm>
        }

        @if (fees is not null)
        {
            <EditForm Model="form" OnSubmit="SaveFeesAsync" class="panel stack" aria-label="The provider's fee rate" Context="feesForm">
                <div class="actions">
                    <label>
                        Fee, % of each payment
                        <input id="fee-percent" type="number" min="0" max="30" step="0.01" @bind="form.FeePercent" required />
                    </label>
                    <label>
                        Plus, per payment
                        <input id="fee-fixed" type="number" min="0" max="10000" step="0.01" @bind="form.FeeFixed" required />
                    </label>
                </div>
                <p class="muted small">
                    The provider's rate, from its own statement. The fee estimate above uses it.
                    @(fees.Set ? "" : " This is the configured rate.")
                </p>
                <div class="actions">
                    <button class="btn" type="submit" disabled="@busy">Save rate</button>
                    @if (fees.Set)
                    {
                        <button class="btn btn-quiet" type="button" disabled="@busy" @onclick="ClearFeesAsync">Use the configured rate</button>
                    }
                    @if (feesNotice is not null)
                    {
                        <span class="muted small" role="status">@feesNotice</span>
                    }
                </div>
                <ErrorNotice Message="@feesError" />
            </EditForm>
        }
    </section>
}

@code {
    /// <summary>
    /// What the API says of a value an admin set here (Identity.API's PaymentSettingsApi).
    /// </summary>
    private const string FromSettings = "settings";

    /// <summary>
    /// Raised after the fee rate changed, so the statement above is worked out again.
    /// </summary>
    [Parameter] public EventCallback OnFeesChanged { get; set; }

    private PaymentSettings? settings;
    private FeeSettings? fees;
    private Form form = new();
    private bool busy;
    private bool confirmClear;
    private string? notice;
    private string? error;
    private string? feesNotice;
    private string? feesError;

    protected override async Task OnInitializedAsync()
    {
        // Two services, each on its own: one that isn't answering doesn't take the other's form with it.
        var settingsTask = Identity.GetPaymentSettingsAsync();
        var feesTask = Books.GetFeesAsync();
        Show(await OrNothingAsync(settingsTask));
        Show(await OrNothingAsync(feesTask));
    }

    private static async Task<T?> OrNothingAsync<T>(Task<T?> load) where T : class
    {
        try
        {
            return await load;
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            return null;
        }
    }

    /// <summary>
    /// Whether Stripe's fields are on the page: it is chosen in the form, or it is the provider in force.
    /// </summary>
    private bool StripeShown => form.Provider == "stripe" || settings?.Provider == "stripe";

    private void Show(PaymentSettings? payments)
    {
        if (payments is not null)
        {
            settings = payments;
            (form.Provider, form.SecretKey, form.WebhookSecret) = (payments.Provider, null, null);
            form.PortalUrl = payments.StripePortalUrlFrom == FromSettings ? payments.StripePortalUrl : null;
        }
    }

    private void Show(FeeSettings? rate)
    {
        if (rate is not null)
        {
            (fees, form.FeePercent, form.FeeFixed) = (rate, rate.Percent, rate.Fixed);
        }
    }

    /// <summary>
    /// Only what changed is sent, so a field left alone goes on following the deployment's configuration.
    /// </summary>
    private Task SaveProviderAsync() => ChangeAsync(provider: true, async () =>
    {
        var current = settings!;
        var portalWas = current.StripePortalUrlFrom == FromSettings ? current.StripePortalUrl ?? "" : "";
        var saved = await Identity.SavePaymentSettingsAsync(new SavePaymentSettings(
            (form.Provider ?? "") == current.Provider ? null : form.Provider ?? "",
            // Keys typed and then hidden by choosing another provider aren't on the page any more: they aren't saved.
            StripeShown ? form.SecretKey : null, StripeShown ? form.WebhookSecret : null,
            (form.PortalUrl ?? "") == portalWas ? null : form.PortalUrl ?? ""));
        Show(saved);
        return saved is null ? null : "Saved.";
    });

    private Task ClearProviderAsync() => ChangeAsync(provider: true, async () =>
    {
        var cleared = await Identity.ClearPaymentSettingsAsync();
        Show(cleared);
        return cleared is null ? null : "The deployment's configuration is in force again.";
    });

    private Task SaveFeesAsync() => ChangeAsync(provider: false, async () =>
    {
        var saved = await Books.SaveFeesAsync(form.FeePercent, form.FeeFixed);
        Show(saved);
        return saved is null ? null : "Saved.";
    });

    private Task ClearFeesAsync() => ChangeAsync(provider: false, async () =>
    {
        var cleared = await Books.ClearFeesAsync();
        Show(cleared);
        return cleared is null ? null : "The configured rate is in force again.";
    });

    /// <summary>
    /// Runs one change to the provider's form or the fee rate's: busy meanwhile, then that form's notice or error.
    /// </summary>
    /// <param name="change">Returns what to say, or null when it didn't go through.</param>
    private async Task ChangeAsync(bool provider, Func<Task<string?>> change)
    {
        (busy, confirmClear) = (true, false);
        (notice, error, feesNotice, feesError) = (null, null, null, null);
        string? said = null, failed = null;
        try
        {
            said = await change();
            failed = said is null ? "That didn't go through: only admins can change this." : null;
        }
        catch (Exception ex) when (ex is HttpRequestException or SignInRequiredException)
        {
            failed = ErrorNotice.Describe(ex);
        }
        finally
        {
            busy = false;
        }
        if (provider)
        {
            (notice, error) = (said, failed);
        }
        else
        {
            (feesNotice, feesError) = (said, failed);
            if (said is not null)
            {
                // The rate changed: the statement above is worked out again. Said first, so the confirmation stands
                // whatever becomes of that reload.
                await OnFeesChanged.InvokeAsync();
            }
        }
    }

    private static string ProviderName(string provider) => provider switch
    {
        "stripe" => "Stripe",
        "test" => "the test provider (development only)",
        _ => provider
    };

    private static string KeyState(string from) => from switch
    {
        FromSettings => "(set here)",
        "configuration" => "(set in the deployment's configuration)",
        _ => "(not set)"
    };

    private sealed class Form
    {
        public string? Provider { get; set; }
        public string? SecretKey { get; set; }
        public string? WebhookSecret { get; set; }
        public string? PortalUrl { get; set; }
        public decimal FeePercent { get; set; }
        public decimal FeeFixed { get; set; }
    }
}
