@inject ClientInfo Client

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Routes).Assembly">
        <Found Context="routeData">
            @if (FlagOf(routeData.PageType) is { } flag)
            {
                <Feature Flag="@flag">
                    <ChildContent>
                        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                    </ChildContent>
                    <Off>
                        <LayoutView Layout="typeof(MainLayout)">
                            <h1>Not available</h1>
                            <p>This feature is switched off right now. <a href="">Back to Home</a></p>
                        </LayoutView>
                    </Off>
                </Feature>
            }
            else
            {
                <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
            }
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <h1>Not found</h1>
                <p>There's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// The browser's IP address, passed in by the web app's host page; Blazor protects component parameters, so the
    /// browser can't change it. The mobile app leaves it unset.
    /// </summary>
    [Parameter] public string? ClientAddress { get; set; }

    protected override void OnInitialized() => Client.Address ??= ClientAddress;

    private static string? FlagOf(Type page) =>
        (Attribute.GetCustomAttribute(page, typeof(RequiresFeatureAttribute)) as RequiresFeatureAttribute)?.Flag;
}
