<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Shared Razor UI used by both the Blazor web app and the MAUI Blazor Hybrid app.
    Every screen is written once here; the hosts provide sign-in, tokens, push and offline storage.
  -->

  <ItemGroup>
    <!-- The flag keys, shared with the services so both gate a feature by the same key. -->
    <Compile Include="..\..\TvTracker.ServiceDefaults\FeatureFlags.cs" Link="Services\FeatureFlags.cs" />
    <!-- Show DNA's traits and labels, shared with Analytics and Recommendations. -->
    <Compile Include="..\..\TvTracker.IntegrationEvents\DnaTraits.cs" Link="Models\DnaTraits.cs" />
    <Compile Include="..\..\TvTracker.IntegrationEvents\SeasonVerdicts.cs" Link="Models\SeasonVerdicts.cs" />
    <Compile Include="..\..\TvTracker.IntegrationEvents\Plans.cs" Link="Models\Plans.cs" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="OpenFeature" />
  </ItemGroup>

</Project>
