@inject TvTracker.UI.Services.Branding Brand
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@Brand.AppName</title>
    <script src="@Assets["_content/TvTracker.UI/theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["_content/TvTracker.UI/app.css"]" />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    <Routes @rendermode="RenderMode" ClientAddress="@HttpContext?.Connection.RemoteIpAddress?.ToString()" />
    <script src="@Assets["js/tvtracker.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Static render of the host page: the browser's own request, so its address is real. Behind a reverse proxy,
    // configure ForwardedHeaders so this is the client's address rather than the proxy's.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // No prerendering: pages load their data once, after the circuit (and the user's token) is available.
    private static readonly IComponentRenderMode RenderMode = new InteractiveServerRenderMode(prerender: false);
}
