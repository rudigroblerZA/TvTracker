{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "tracking": {
        "ClusterId": "tracking",
        "Match": { "Path": "/tracking/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/tracking" } ]
      },
      "ratings": {
        "ClusterId": "ratings",
        "Match": { "Path": "/ratings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/ratings" } ]
      },
      "recommendations": {
        "ClusterId": "recommendations",
        "Match": { "Path": "/recommendations/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/recommendations" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/notifications" } ]
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/analytics/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/analytics" } ]
      },
      "social": {
        "ClusterId": "social",
        "Match": { "Path": "/social/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/social" } ]
      },
      "features": {
        "ClusterId": "features",
        "Match": { "Path": "/features/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/features" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "https+http://identity-api" } }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "https+http://catalog-api" } }
      },
      "tracking": {
        "Destinations": { "d1": { "Address": "https+http://tracking-api" } }
      },
      "ratings": {
        "Destinations": { "d1": { "Address": "https+http://ratings-api" } }
      },
      "recommendations": {
        "Destinations": { "d1": { "Address": "https+http://recommendations-api" } }
      },
      "notifications": {
        "Destinations": { "d1": { "Address": "https+http://notifications-api" } }
      },
      "analytics": {
        "Destinations": { "d1": { "Address": "https+http://analytics-api" } }
      },
      "social": {
        "Destinations": { "d1": { "Address": "https+http://social-api" } }
      },
      "features": {
        "Destinations": { "d1": { "Address": "http://_ofrep.flagd" } }
      }
    }
  }
}
