<Project>
  <!--
    Central package versions. Versions were current when this code was written;
    run `aspire update` (or list outdated packages with the dotnet CLI) to bring them up to date.
    The MAUI app opts out of central management and pins its own versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspireVersion>13.6.5</AspireVersion>
    <AspNetCoreVersion>10.0.15</AspNetCoreVersion>
    <!-- dotnet/runtime packages (Microsoft.Extensions.*), which service on their own numbers; MobileApp uses it too. -->
    <RuntimeVersion>10.0.14</RuntimeVersion>
    <EfCoreVersion>10.0.15</EfCoreVersion>
    <OpenTelemetryVersion>1.21.0</OpenTelemetryVersion>
    <OpenTelemetryInstrumentationVersion>1.21.0</OpenTelemetryInstrumentationVersion>
  </PropertyGroup>
  <ItemGroup Label="Aspire hosting (AppHost)">
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <!-- Community Toolkit: flagd, the OpenFeature flag server. -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Flagd" Version="13.6.1" />
  </ItemGroup>
  <ItemGroup Label="Aspire client integrations (services)">
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.5" />
  </ItemGroup>
  <ItemGroup Label="Service defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryInstrumentationVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryInstrumentationVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryInstrumentationVersion)" />
  </ItemGroup>
  <ItemGroup Label="ASP.NET Core and EF Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(RuntimeVersion)" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup Label="Search (vectors)">
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup Label="Feature flags (OpenFeature)">
    <PackageVersion Include="OpenFeature" Version="2.14.1" />
    <PackageVersion Include="OpenFeature.Hosting" Version="2.14.1" />
    <PackageVersion Include="OpenFeature.Providers.Flagd" Version="0.8.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Tools">
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Label="Messaging and delivery">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Microsoft.Azure.NotificationHubs" Version="4.2.0" />
    <PackageVersion Include="WebPush" Version="1.0.13" />
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
  </ItemGroup>
</Project>