<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of Analytics' raw-SQL queries (the time machine's week scan) against a real Postgres in a container
       (tests/Shared): they use unnest and the air-time index, which an in-memory provider can't run; and of Taste Match's endpoints, whose
       states and rules of who may do what live in stored matches. Needs Docker. -->

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <ProjectReference Include="..\..\src\Services\Analytics\Analytics.API\Analytics.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine's facts and insights are used throughout. -->
    <Using Include="TvTracker.InsightsEngine" />
  </ItemGroup>

</Project>
