<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of Ratings' favourite-character votes against a real Postgres in a container (tests/Shared): the counts
       are a grouped query and a vote is a raw upsert, so they're tested as SQL. Needs Docker. -->

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="System.Formats.Cbor" />
    <ProjectReference Include="..\..\src\Services\Ratings\Ratings.API\Ratings.API.csproj" />
  </ItemGroup>

</Project>
